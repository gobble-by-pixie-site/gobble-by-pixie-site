---
import '../styles/global.css';
import GlutenFreeIcon from '../components/GlutenFreeIcon.astro';
import { fetchSiteContent } from '../lib/fetchSiteContent.js';
import { fetchProducts, getCategories, slugify } from '../lib/fetchProducts.js';

const content = await fetchSiteContent();

// Menu dropdown categories are fetched live here (not hardcoded) so that adding
// a category row to the Products sheet makes it show up in the header nav on
// the next rebuild, same as it already does in menu.astro's own sub-nav —
// same pattern theclosetstory.com/tcs-store uses for its Categories dropdown.
const navProducts = await fetchProducts();
const menuCategories = getCategories(navProducts);

const SITE_URL = 'https://gobblebypixie.com';

const { title = 'Gobble by Pixie — Artisanal Cream Cheese & Cheese Platters', description = `${content.tagline}. Gluten-free, keto-friendly artisanal cream cheese and handcrafted grazing boards, delivered across Delhi NCR.` } = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const canonicalUrl = SITE_URL + path;
const ogImage = SITE_URL + '/og-image.jpg';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />

  <!-- Favicon — generated from the Gobble logo's 'g' mark, public/Logos/ is
       the raw wordmark (too wide/detailed for a small tab icon as-is) -->
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

  <!-- Open Graph / social share preview -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Gobble by Pixie" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <script is:inline src="/cart.js"></script>
</head>
<body>
  <div class="fulfillment-banner">
    <span>🧀 {content.fulfillment_platters}</span>
    <span class="banner-divider">•</span>
    <span>✨ {content.fulfillment_jars}</span>
  </div>

  <header class="site-header">
    <div class="container header-top">
      <a href="/" class="logo">
        <img src="/Logos/Gobble Logo-TM-Black.png" alt="Gobble by Pixie" class="logo-img" />
      </a>

      <div class="header-actions">
        <a href="/account" class:list={['account-icon-link', { active: isActive('/account') }]} aria-label="My Account">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-user"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </a>
        <button class="cart-toggle" id="cartToggle" aria-label="View cart">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shopping-bag"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
          <span class="cart-count" id="cartCount" style="display:none;">0</span>
        </button>
        <button class="mobile-toggle" id="mobileMenuToggle" aria-label="Toggle navigation menu">
          <span class="hamburger-bar"></span>
          <span class="hamburger-bar"></span>
          <span class="hamburger-bar"></span>
        </button>
      </div>
    </div>
    <div class="container header-bottom">
      <nav class="main-nav" id="desktopNav">
        <div class="dropdown">
          <a href="/menu" class:list={['dropdown-toggle', { active: isActive('/menu') }]}>Menu</a>
          <div class="dropdown-menu">
            {menuCategories.map((cat) => <a href={`/menu/${slugify(cat)}`}>{cat}</a>)}
            <a href="/menu/grazing-tables">Grazing Tables</a>
          </div>
        </div>
        <a href="/byop" class:list={['nav-byop', { active: isActive('/byop') }]}>#BYOP Platter Builder</a>
        <a href="/events" class:list={{ active: isActive('/events') }}>Events</a>
        <a href="/about" class:list={{ active: isActive('/about') }}>Our Story</a>
        <a href="/faq" class:list={{ active: isActive('/faq') }}>Delivery & FAQ</a>
      </nav>
    </div>
  </header>

  <!-- Cart Drawer -->
  <div class="cart-drawer" id="cartDrawer">
    <div class="cart-drawer-inner">
      <div class="cart-drawer-header">
        <h3>Your Order</h3>
        <button class="cart-close" id="cartClose" aria-label="Close cart">&times;</button>
      </div>
      <div class="cart-items" id="cartItems"></div>
      <div class="cart-footer">
        <div class="cart-summary" id="cartSummary" style="display:none;">
          <div class="cart-summary-row"><span>Taxable Value</span><span id="cartTaxableValue">₹0</span></div>
          <div class="cart-summary-row"><span>CGST (2.5%)</span><span id="cartCgst">₹0</span></div>
          <div class="cart-summary-row"><span>SGST (2.5%)</span><span id="cartSgst">₹0</span></div>
          <div class="cart-summary-row cart-summary-total"><span>Total (incl. GST)</span><span id="cartTotalAmount">₹0</span></div>
        </div>
        <p class="cart-unpriced-note" id="cartUnpricedNote" style="display:none;">Some items are priced on request — final total confirmed on WhatsApp.</p>
        <a href="#" id="cartCheckoutBtn" target="_blank" rel="noopener" class="btn btn-primary cart-checkout-btn">Checkout via WhatsApp 💬</a>
      </div>
    </div>
  </div>
  <div class="cart-backdrop" id="cartBackdrop"></div>

  <!-- Mobile Drawer Overlay — deliberately NOT nested inside <header>: that element has
       backdrop-filter, which creates a new containing block for position:fixed descendants
       and silently breaks fixed positioning relative to the viewport. -->
  <div class="mobile-drawer" id="mobileDrawer">
    <nav class="mobile-nav">
      <a href="/menu" class:list={['mobile-nav-item', { active: isActive('/menu') }]}>Menu</a>
      <a href="/byop" class:list={['mobile-nav-item', 'mobile-nav-byop', { active: isActive('/byop') }]}>✨ Build Your Platter (#BYOP)</a>
      <a href="/events" class:list={['mobile-nav-item', { active: isActive('/events') }]}>Events</a>
      <a href="/about" class:list={['mobile-nav-item', { active: isActive('/about') }]}>Our Story</a>
      <a href="/faq" class:list={['mobile-nav-item', { active: isActive('/faq') }]}>Delivery & FAQ</a>
      <a href="/account" class:list={['mobile-nav-item', { active: isActive('/account') }]}>My Account / Rewards</a>
      <div class="mobile-drawer-cta">
        <a href="/byop" class="btn btn-primary" style="width:100%">Start #BYOP Platter</a>
      </div>
    </nav>
  </div>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <div class="footer-brand">
        <a href="/" class="logo"><img src="/Logos/Gobble Logo-TM-Black.png" alt="Gobble by Pixie" class="logo-img" /></a>
        <p class="footer-tag">{content.tagline}</p>
        <div class="footer-badges">
          <span class="badge badge-veg">100% Vegetarian</span>
          <span class="badge badge-gf"><GlutenFreeIcon /> Gluten-Free</span>
          <span class="badge badge-keto">Keto-Friendly</span>
        </div>
      </div>

      <div class="footer-links">
        <div class="footer-col">
          <strong>Explore</strong>
          <a href="/menu">Full Catalog</a>
          <a href="/byop">Custom Platter (#BYOP)</a>
          <a href="/about">Our Artisanal Story</a>
        </div>
        <div class="footer-col">
          <strong>Help & Order</strong>
          <a href="/faq">Fulfillment Schedule</a>
          <a href="/account">My Account & Points</a>
          <a href="https://wa.link/sngzs9" target="_blank" rel="noopener">WhatsApp Direct Order</a>
          <a href="https://www.instagram.com/gobblebypixie/" target="_blank" rel="noopener">Instagram (@gobblebypixie)</a>
        </div>
      </div>
    </div>

    <div class="container">
      <div class="footer-bottom">
        <p class="footer-note">Delivering fresh across Delhi, Gurgaon, Noida, Ghaziabad & Faridabad. Zero preservatives, always small-batch.</p>
        <p class="footer-legal">FSSAI Lic. No. {content.fssai_number} &nbsp;·&nbsp; GSTIN: {content.gstin}</p>
        <p class="copyright">&copy; {new Date().getFullYear()} Gobble by Pixie. All rights reserved.</p>
      </div>
    </div>
  </footer>

  <!-- Floating WhatsApp contact button — real product jar, bounces gently, with a WhatsApp badge so it clearly reads as "contact us" -->
  <a
    href="https://wa.link/sngzs9"
    target="_blank"
    rel="noopener"
    class="wa-fab"
    aria-label="Chat with Gobble by Pixie on WhatsApp"
  >
    <span class="wa-fab-face">
      <span class="wa-fab-ping"></span>
      <img src="/Green Jar.png" alt="" class="wa-fab-jar" />
      <span class="wa-fab-chat-badge">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.9-4.45 9.9-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm5.8 14.13c-.24.68-1.4 1.3-1.93 1.38-.5.08-1.12.11-1.8-.11-.42-.14-.95-.32-1.64-.62-2.88-1.24-4.76-4.14-4.9-4.33-.14-.19-1.17-1.56-1.17-2.98 0-1.41.74-2.11 1-2.4.26-.29.57-.36.76-.36.19 0 .38 0 .55.01.18.01.41-.07.64.49.24.57.81 1.98.88 2.12.07.14.12.31.02.5-.09.19-.14.31-.28.48-.14.16-.29.36-.42.48-.14.14-.28.28-.12.55.16.28.71 1.17 1.53 1.9 1.05.94 1.94 1.23 2.21 1.37.28.14.44.12.6-.07.16-.19.69-.8.87-1.08.19-.28.37-.23.62-.14.26.09 1.63.77 1.91.91.28.14.47.21.54.33.07.12.07.68-.17 1.36z"/></svg>
      </span>
    </span>
  </a>

  <style>
    .fulfillment-banner {
      background: var(--text-espresso);
      color: #ffffff;
      text-align: center;
      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: 0.02em;
      padding: 0.6rem 1rem;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 0.6rem;
      flex-wrap: wrap;
    }
    .banner-divider { opacity: 0.6; }

    .site-header {
      background: rgba(253, 251, 242, 0.92);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border-hairline);
      position: sticky;
      top: 0;
      z-index: 100;
    }
    .header-top {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      padding-top: var(--space-sm);
      padding-bottom: var(--space-sm);
      height: 92px;
    }
    .header-bottom {
      display: flex;
      align-items: center;
      justify-content: center;
      padding-bottom: 0.8rem;
    }
    .logo { grid-column: 2; justify-self: center; display: flex; align-items: center; }
    .logo-img { height: 68px; width: auto; display: block; }
    .footer-brand .logo-img { height: 44px; }

    .main-nav {
      display: flex;
      align-items: center;
      gap: var(--space-md);
    }
    .main-nav a {
      font-size: 0.92rem;
      font-weight: 600;
      color: var(--text-espresso-soft);
      transition: color 0.2s ease;
      position: relative;
    }
    .main-nav a:hover { color: var(--accent-berry); }
    .main-nav a::after {
      content: '';
      position: absolute;
      left: 0; right: 0; bottom: -6px;
      height: 2px;
      background: var(--accent-berry);
      border-radius: 2px;
      transform: scaleX(0);
      transition: transform 0.25s ease;
    }
    .main-nav a.active { color: var(--accent-berry); }
    .main-nav a.active::after,
    .main-nav a:hover::after { transform: scaleX(1); }
    .nav-byop {
      color: var(--accent-gold-deep) !important;
      background: var(--accent-gold-light);
      padding: 0.3rem 0.8rem;
      border-radius: var(--radius-pill);
      border: 1px solid rgba(232, 157, 23, 0.3);
    }
    .nav-byop:hover { background: var(--accent-gold); color: #ffffff !important; }
    .nav-byop.active { background: var(--accent-gold); color: #ffffff !important; }
    .nav-byop.active::after { display: none; }

    /* Dropdown */
    .dropdown {
      position: relative;
    }
    .dropdown-menu {
      position: absolute;
      top: 100%;
      left: 50%;
      transform: translateX(-50%) translateY(10px);
      background: var(--bg-parchment);
      border: 1px solid var(--border-hairline);
      border-radius: var(--radius-sm);
      box-shadow: var(--shadow-ambient-lg);
      padding: 0.5rem 0;
      min-width: 180px;
      opacity: 0;
      visibility: hidden;
      transition: all 0.2s ease;
      z-index: 100;
    }
    .dropdown:hover .dropdown-menu {
      opacity: 1;
      visibility: visible;
      transform: translateX(-50%) translateY(0);
    }
    .dropdown-menu a {
      display: block;
      padding: 0.5rem 1rem;
      font-size: 0.85rem;
      color: var(--text-espresso-soft);
      white-space: nowrap;
    }
    .dropdown-menu a::after { display: none; }
    .dropdown-menu a:hover {
      background: var(--bg-parchment-alt);
      color: var(--accent-berry);
    }

    .header-actions { grid-column: 3; justify-self: end; display: flex; align-items: center; gap: 0.75rem; }
    .account-icon-link {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 38px;
      height: 38px;
      color: var(--text-espresso-soft);
      border-radius: 50%;
      transition: all 0.2s ease;
    }
    .account-icon-link:hover, .account-icon-link.active {
      color: var(--accent-berry);
      background: rgba(161, 95, 96, 0.08);
    }

    /* ── Cart toggle + drawer ── */
    .cart-toggle {
      position: relative; background: none; border: none; border-radius: 50%;
      width: 38px; height: 38px; display: flex; align-items: center; justify-content: center;
      color: var(--text-espresso-soft); cursor: pointer; transition: all 0.2s ease;
    }
    .cart-toggle:hover {
      color: var(--accent-berry);
      background: rgba(161, 95, 96, 0.08);
    }
    .cart-count {
      position: absolute; top: -6px; right: -6px; min-width: 18px; height: 18px; padding: 0 4px;
      border-radius: 999px; background: var(--accent-berry); color: #fff; font-size: 0.68rem; font-weight: 700;
      align-items: center; justify-content: center;
    }

    .cart-backdrop {
      display: none; position: fixed; inset: 0; background: rgba(36, 21, 18, 0.4); z-index: 210;
    }
    .cart-backdrop.open { display: block; }

    .cart-drawer {
      position: fixed; top: 0; right: 0; height: 100vh; width: min(400px, 92vw);
      background: var(--bg-parchment); z-index: 220; transform: translateX(100%);
      transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1); box-shadow: -10px 0 30px rgba(0,0,0,0.15);
    }
    .cart-drawer.open { transform: translateX(0); }
    .cart-drawer-inner { display: flex; flex-direction: column; height: 100%; }
    .cart-drawer-header {
      display: flex; justify-content: space-between; align-items: center;
      padding: var(--space-md); border-bottom: 1px solid var(--border-hairline);
    }
    .cart-close { background: none; border: none; font-size: 1.5rem; cursor: pointer; color: var(--text-espresso); line-height: 1; }
    .cart-items { flex: 1; overflow-y: auto; padding: var(--space-sm) var(--space-md); }
    /* .cart-item* / .cart-empty / .qty-btn rules live in global.css, not here —
       these elements are injected via innerHTML at runtime (renderCart() in the
       script below), so they never get Astro's scoped data-astro-cid attribute
       and scoped styles here would silently never match them. */

    .cart-footer { padding: var(--space-md); border-top: 1px solid var(--border-hairline); }
    .cart-summary { margin-bottom: var(--space-sm); }
    .cart-summary-row {
      display: flex; justify-content: space-between; font-size: 0.85rem; color: var(--text-espresso-soft);
      padding: 0.2rem 0;
    }
    .cart-summary-total {
      font-weight: 700; font-family: var(--font-display); font-size: 1.15rem; color: var(--text-espresso);
      border-top: 1px solid var(--border-hairline); margin-top: 0.35rem; padding-top: 0.5rem;
    }
    .cart-unpriced-note { font-size: 0.8rem; color: var(--text-muted); margin: 0 0 var(--space-sm); text-align: center; }
    .cart-checkout-btn { width: 100%; text-align: center; }

    @media (max-width: 720px) {
      .cart-toggle { padding: 0.4rem 0.6rem; }
    }

    .mobile-nav-item.active { color: var(--accent-berry); }
    .mobile-nav-item.active::before {
      content: '🧀 ';
    }

    /* Mobile Hamburger Toggle */
    .mobile-toggle {
      display: none;
      background: none;
      border: none;
      cursor: pointer;
      padding: 0.4rem;
      flex-direction: column;
      gap: 5px;
      z-index: 110;
    }
    .hamburger-bar {
      width: 22px;
      height: 2.2px;
      background: var(--text-espresso);
      border-radius: 2px;
      transition: all 0.3s ease;
    }

    /* Mobile Drawer — display-toggled (not transform/transition-based): a percentage
       transform on this element combined with the compositing layer created by its own
       backdrop-filter proved unreliable to animate via a class toggle alone, so visibility
       is driven directly by display instead of relying on a transition to resolve. */
    .mobile-drawer {
      display: none;
      position: fixed;
      top: 68px;
      left: 0;
      width: 100vw;
      height: calc(100vh - 68px);
      background: rgba(253, 251, 242, 0.98);
      backdrop-filter: blur(16px);
      z-index: 105;
      padding: var(--space-md);
      overflow-y: auto;
    }
    .mobile-drawer.open {
      display: block;
    }
    .mobile-nav {
      display: flex;
      flex-direction: column;
      gap: var(--space-sm);
    }
    .mobile-nav-item {
      font-family: var(--font-display);
      font-size: 1.4rem;
      font-weight: 600;
      color: var(--text-espresso);
      padding: var(--space-xs) 0;
      border-bottom: 1px solid var(--border-hairline);
    }
    .mobile-nav-byop { color: var(--accent-coral-deep); }
    .mobile-drawer-cta { margin-top: var(--space-lg); }

    @media (max-width: 820px) {
      .main-nav { display: none; }
      .mobile-toggle { display: flex; }
      .nav-cta { display: none; }
    }

    /* Footer */
    .site-footer {
      background: var(--bg-parchment-warm);
      border-top: 1px solid var(--border-hairline);
      padding: var(--space-xl) 0 var(--space-md);
      margin-top: var(--space-2xl);
    }
    .footer-inner {
      display: grid;
      grid-template-columns: 1fr 1.2fr;
      gap: var(--space-xl);
      padding-bottom: var(--space-lg);
    }
    .footer-brand { display: flex; flex-direction: column; gap: 0.6rem; }
    .footer-tag { font-family: var(--font-serif-italic); font-size: 1.15rem; font-style: italic; color: var(--accent-berry-deep); }
    .footer-badges { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-top: 0.4rem; }

    .footer-links { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-md); }
    .footer-col { display: flex; flex-direction: column; gap: 0.5rem; }
    .footer-col strong { font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent-gold-deep); }
    .footer-col a { font-size: 0.9rem; color: var(--text-espresso-soft); transition: color 0.2s ease; }
    .footer-col a:hover { color: var(--accent-berry); }

    .footer-bottom {
      border-top: 1px solid var(--border-hairline);
      padding-top: var(--space-md);
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: var(--space-sm);
    }
    .footer-note { font-size: 0.82rem; color: var(--text-muted); margin: 0; }
    .footer-legal { font-size: 0.78rem; font-weight: 600; color: var(--text-espresso-soft); margin: 0; width: 100%; text-align: center; order: 3; padding-top: 0.4rem; }
    .copyright { font-size: 0.8rem; color: var(--text-muted); opacity: 0.8; margin: 0; }

    @media (max-width: 720px) {
      .footer-inner { grid-template-columns: 1fr; gap: var(--space-lg); }
      .footer-links { grid-template-columns: 1fr; }
      .footer-bottom { flex-direction: column; text-align: center; }
    }

    /* ── Floating WhatsApp mascot ── */
    .wa-fab {
      position: fixed;
      right: 1.4rem;
      bottom: 1.4rem;
      z-index: 200;
    }
    .wa-fab-face {
      position: relative;
      width: 76px;
      height: 76px;
      display: flex;
      align-items: center;
      justify-content: center;
      animation: wa-bob 2.4s ease-in-out infinite;
      cursor: pointer;
    }
    .wa-fab-jar {
      width: 100%;
      height: 100%;
      object-fit: contain;
      filter: drop-shadow(0 10px 16px rgba(60, 40, 20, 0.35));
    }
    .wa-fab-chat-badge {
      position: absolute;
      bottom: 2px;
      right: -2px;
      width: 26px;
      height: 26px;
      border-radius: 50%;
      background: #25D366; /* WhatsApp brand green, not a site token — real 3rd-party brand color */
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 0 0 2px #fff;
      z-index: 1;
    }

    /* ping ring sits inside .wa-fab-face so it wraps the 76px jar circle,
       not the old bubble+jar row (fixed 2026-07-31 — was inset:0 on a
       sibling of the bubble, so it stretched across the whole flex row) */
    .wa-fab-ping {
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background: var(--accent-teal);
      opacity: 0.55;
      animation: wa-ping 2.4s ease-out infinite;
    }

    .wa-fab:hover .wa-fab-face { animation-play-state: paused; transform: scale(1.08) rotate(-4deg); }

    @keyframes wa-bob {
      0%, 100% { transform: translateY(0) rotate(-3deg); }
      50% { transform: translateY(-8px) rotate(3deg); }
    }
    @keyframes wa-ping {
      0% { transform: scale(1); opacity: 0.5; }
      100% { transform: scale(1.6); opacity: 0; }
    }

    @media (max-width: 720px) {
      .wa-fab { right: 1rem; bottom: 1rem; }
      body:has(.mobile-sticky-bar) .wa-fab { bottom: 5rem; }
      .wa-fab-face { width: 58px; height: 58px; }
    }

    @media (prefers-reduced-motion: reduce) {
      .wa-fab-face, .wa-fab-ping { animation: none; }
    }
  </style>

  <script>
    const toggle = document.getElementById('mobileMenuToggle');
    const drawer = document.getElementById('mobileDrawer');

    toggle?.addEventListener('click', () => {
      drawer?.classList.toggle('open');
      const isOpen = drawer?.classList.contains('open');
      toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    });

    // Close drawer when clicking nav links
    document.querySelectorAll('.mobile-nav-item').forEach((link) => {
      link.addEventListener('click', () => {
        drawer?.classList.remove('open');
      });
    });

    // ── Cart drawer ──
    const cartToggle = document.getElementById('cartToggle');
    const cartDrawer = document.getElementById('cartDrawer');
    const cartBackdrop = document.getElementById('cartBackdrop');
    const cartClose = document.getElementById('cartClose');
    const cartItemsEl = document.getElementById('cartItems');
    const cartCountEl = document.getElementById('cartCount');
    const cartSummary = document.getElementById('cartSummary');
    const cartTaxableValue = document.getElementById('cartTaxableValue');
    const cartCgst = document.getElementById('cartCgst');
    const cartSgst = document.getElementById('cartSgst');
    const cartTotalAmount = document.getElementById('cartTotalAmount');
    const cartUnpricedNote = document.getElementById('cartUnpricedNote');
    const cartCheckoutBtn = document.getElementById('cartCheckoutBtn');

    function openCart() { cartDrawer?.classList.add('open'); cartBackdrop?.classList.add('open'); }
    function closeCart() { cartDrawer?.classList.remove('open'); cartBackdrop?.classList.remove('open'); }

    cartToggle?.addEventListener('click', openCart);
    cartClose?.addEventListener('click', closeCart);
    cartBackdrop?.addEventListener('click', closeCart);

    function escapeHtml(str) {
      return String(str ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    }

    function renderCart(items) {
      const count = items.reduce((s, i) => s + (i.qty || 1), 0);
      if (cartCountEl) {
        cartCountEl.textContent = count;
        cartCountEl.style.display = count > 0 ? 'flex' : 'none';
      }

      if (!cartItemsEl) return;

      if (!items.length) {
        cartItemsEl.innerHTML = '<p class="cart-empty">Your cart is empty. Browse the <a href="/menu">menu</a> to get started!</p>';
        cartSummary.style.display = 'none';
        cartUnpricedNote.style.display = 'none';
        if (cartCheckoutBtn) { cartCheckoutBtn.style.pointerEvents = 'none'; cartCheckoutBtn.style.opacity = '0.5'; }
        return;
      }
      if (cartCheckoutBtn) { cartCheckoutBtn.style.pointerEvents = ''; cartCheckoutBtn.style.opacity = ''; }

      cartItemsEl.innerHTML = items.map((item, idx) => {
        const unitPriceStr = typeof item.price === 'number' ? ('₹' + item.price.toLocaleString('en-IN') + ' each') : 'Price on request';
        const lineTotalStr = typeof item.price === 'number' ? ('₹' + (item.price * item.qty).toLocaleString('en-IN')) : '';
        const thumb = item.image
          ? '<div class="cart-item-thumb" style="background-image:url(' + escapeHtml(item.image) + ')"></div>'
          : '<div class="cart-item-thumb cart-item-thumb-placeholder">🧀</div>';
        return '<div class="cart-item">'
          + thumb
          + '<div class="cart-item-info">'
          + '<p class="cart-item-name">' + escapeHtml(item.name) + '</p>'
          + (item.note ? '<p class="cart-item-note">' + escapeHtml(item.note) + '</p>' : '')
          + '<div class="cart-item-price-row">'
          + '<span class="cart-item-unit-price">' + unitPriceStr + '</span>'
          + (lineTotalStr ? '<span class="cart-item-line-total">' + lineTotalStr + '</span>' : '')
          + '</div>'
          + '<div class="cart-item-controls">'
          + '<div class="cart-item-qty">'
          + '<button class="qty-btn" data-idx="' + idx + '" data-action="dec" aria-label="Decrease quantity">−</button>'
          + '<span>' + item.qty + '</span>'
          + '<button class="qty-btn" data-idx="' + idx + '" data-action="inc" aria-label="Increase quantity">+</button>'
          + '</div>'
          + '<button class="cart-item-remove" data-idx="' + idx + '" aria-label="Remove item">&times;</button>'
          + '</div>'
          + '</div>'
          + '</div>';
      }).join('');

      const hasUnpriced = window.GobbleCart.hasUnpricedItems();
      if (hasUnpriced) {
        cartSummary.style.display = 'none';
        cartUnpricedNote.style.display = 'block';
      } else {
        const gst = window.GobbleCart.gstBreakdown();
        cartSummary.style.display = 'block';
        cartUnpricedNote.style.display = 'none';
        cartTaxableValue.textContent = '₹' + gst.taxableValue.toLocaleString('en-IN');
        cartCgst.textContent = '₹' + gst.cgst.toLocaleString('en-IN');
        cartSgst.textContent = '₹' + gst.sgst.toLocaleString('en-IN');
        cartTotalAmount.textContent = '₹' + gst.total.toLocaleString('en-IN');
      }

      if (cartCheckoutBtn) cartCheckoutBtn.href = window.GobbleCart.checkoutWhatsAppUrl();

      cartItemsEl.querySelectorAll('.qty-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const idx = Number(btn.getAttribute('data-idx'));
          const action = btn.getAttribute('data-action');
          const current = window.GobbleCart.get()[idx];
          if (!current) return;
          window.GobbleCart.setQtyAt(idx, current.qty + (action === 'inc' ? 1 : -1));
        });
      });
      cartItemsEl.querySelectorAll('.cart-item-remove').forEach((btn) => {
        btn.addEventListener('click', () => window.GobbleCart.removeAt(Number(btn.getAttribute('data-idx'))));
      });
    }

    if (window.GobbleCart) {
      window.GobbleCart.subscribe(renderCart);
      if (cartCheckoutBtn) cartCheckoutBtn.href = window.GobbleCart.checkoutWhatsAppUrl();
    }
  </script>
</body>
</html>

