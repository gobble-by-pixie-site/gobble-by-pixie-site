---
import '../styles/global.css';
import GlutenFreeIcon from '../components/GlutenFreeIcon.astro';
import { fetchSiteContent } from '../lib/fetchSiteContent.js';
import { fetchProducts, getCategories, slugify } from '../lib/fetchProducts.js';

const content = await fetchSiteContent();

// Menu dropdown categories are fetched live here (not hardcoded) so that adding
// a category row to the Products sheet makes it show up in the header nav on
// the next rebuild, same as it already does in menu.astro's own sub-nav —
// same pattern theclosetstory.com/tcs-store uses for its Categories dropdown.
import { fetchFromConsoleCollections, fetchStoreConfig } from '../lib/console-client';

const navProducts = await fetchProducts();
const storeConfig = await fetchStoreConfig();

// Cart cross-sells — Console collection 'cross-sells' (per-tenant, owner-editable).
let crossSells = [];
try {
  const ccRes = await fetchFromConsoleCollections();
  const coll = (ccRes?.collections ?? []).find((c) => c.slug === 'cross-sells');
  crossSells = (coll?.products ?? [])
    .filter((p) => p.price != null)
    .slice(0, 3)
    .map((p) => ({ id: p.slug, name: p.name, image_url: p.image || '', price: p.discountPrice ?? p.price }));
} catch {}
const menuCategories = getCategories(navProducts);

const SITE_URL = 'https://gobblebypixie.com';

const { title = 'Gobble by Pixie — Artisanal Cream Cheese & Cheese Platters', description = `${content.tagline}. Gluten-free, keto-friendly artisanal cream cheese and handcrafted grazing boards, delivered across Delhi NCR.` } = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const canonicalUrl = SITE_URL + path;
const ogImage = SITE_URL + '/og-image.jpg';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="light" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />

  <!-- Favicon — generated from the Gobble logo's 'g' mark, public/Logos/ is
       the raw wordmark (too wide/detailed for a small tab icon as-is) -->
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

  <!-- Open Graph / social share preview -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Gobble by Pixie" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Organization structured data — sitewide, real data only. -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "Gobble by Pixie",
    url: SITE_URL,
    logo: `${SITE_URL}/Logos/gobble-logo-tm-black.png`,
    description: "Handmade flavoured cream cheese and handcrafted grazing boards — 100% vegetarian, gluten-free, keto-friendly. Delhi NCR.",
    sameAs: ["https://www.instagram.com/gobblebypixie/"],
  })} />

  <!-- Per-page head extras (Product JSON-LD, noindex, etc.) -->
  <slot name="head" />

  <script is:inline src="/cart.js"></script>

  <!-- Analytics — IDs come from Console → Business (store-config API);
       a tenant with none configured gets no snippets at all. -->
  {storeConfig?.ga4MeasurementId && (
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${storeConfig.ga4MeasurementId}`}></script>
  )}
  {storeConfig?.ga4MeasurementId && (
    <script is:inline define:vars={{ ga: storeConfig.ga4MeasurementId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date()); gtag('config', ga);
    </script>
  )}
  {storeConfig?.gtmContainerId && (
    <script is:inline define:vars={{ gtm: storeConfig.gtmContainerId }}>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});
      var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;
      j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',gtm);
    </script>
  )}
</head>
<body>
  <div class="fulfillment-banner">
    <span>🧀 {content.fulfillment_platters}</span>
    <span class="banner-divider">•</span>
    <span>✨ {content.fulfillment_jars}</span>
  </div>

  <header class="site-header">
    <div class="container header-top">
      <a href="/" class="logo">
        <img src="/Logos/gobble-logo-tm-black.png" alt="Gobble by Pixie" class="logo-img" />
      </a>

      <div class="header-actions">
        <button class="account-icon-link" id="searchToggle" aria-label="Search products" style="background:none;border:none;cursor:pointer;">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.8-3.8"/></svg>
        </button>
        <a href="/account" class:list={['account-icon-link', { active: isActive('/account') }]} aria-label="My Account">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-user"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </a>
        <button class="cart-toggle" id="cartToggle" aria-label="View cart">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shopping-bag"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
          <span class="cart-count" id="cartCount" style="display:none;">0</span>
        </button>
        <button class="mobile-toggle" id="mobileMenuToggle" aria-label="Toggle navigation menu">
          <span class="hamburger-bar"></span>
          <span class="hamburger-bar"></span>
          <span class="hamburger-bar"></span>
        </button>
      </div>
    </div>
    <div class="container header-bottom">
      <nav class="main-nav" id="desktopNav">
        <div class="dropdown">
          <a href="/menu" class:list={['dropdown-toggle', { active: isActive('/menu') }]}>Menu</a>
          <div class="dropdown-menu">
            {menuCategories.map((cat) => <a href={`/menu/${slugify(cat)}`}>{cat}</a>)}
            <a href="/menu/grazing-tables">Grazing Tables</a>
          </div>
        </div>
        <a href="/byop" class:list={['nav-byop', { active: isActive('/byop') }]}>#BYOP Platter Builder</a>
        <a href="/events" class:list={{ active: isActive('/events') }}>Events</a>
        <a href="/about" class:list={{ active: isActive('/about') }}>Our Story</a>
        <a href="/faq" class:list={{ active: isActive('/faq') }}>Delivery & FAQ</a>
      </nav>
    </div>
  </header>

  <!-- Cart Drawer -->
  <div class="cart-drawer" id="cartDrawer">
    <div class="cart-drawer-inner">
      <div class="cart-drawer-header">
        <h3>Your Order</h3>
        <button class="cart-close" id="cartClose" aria-label="Close cart">&times;</button>
      </div>
      <div class="cart-items" id="cartItems"></div>
      <div id="cartCrossSells" style="display:none;" class="cart-cross-sells">
        <p class="cart-cross-sells-title">Goes well with</p>
        <div id="cartCrossSellsRow" class="cart-cross-sells-row"></div>
      </div>
      <div class="cart-footer">
        <div class="cart-summary" id="cartSummary" style="display:none;">
          <div class="cart-summary-row"><span>Taxable Value</span><span id="cartTaxableValue">₹0</span></div>
          <div class="cart-summary-row"><span>CGST (2.5%)</span><span id="cartCgst">₹0</span></div>
          <div class="cart-summary-row"><span>SGST (2.5%)</span><span id="cartSgst">₹0</span></div>
          <div class="cart-summary-row cart-summary-credit" id="cartCreditRow" style="display:none;"><span id="cartCreditLabel">Store credit</span><span id="cartCreditAmountLine">−₹0</span></div>
          <div class="cart-summary-row cart-summary-total"><span>Total (incl. GST)</span><span id="cartTotalAmount">₹0</span></div>
        </div>
        <p class="cart-unpriced-note" id="cartUnpricedNote" style="display:none;">Some items are priced on request — final total confirmed on WhatsApp.</p>
        <a href="#" id="cartCheckoutBtn" target="_blank" rel="noopener" class="btn btn-primary cart-checkout-btn">Checkout via WhatsApp 💬</a>
        {/* COD (2026-10-07): creates a real Console order via /api/checkout/cod
            (needs clients.cod_enabled — 501 otherwise). WhatsApp stays for
            custom platters, unpriced items, and anyone who prefers chat.
            Rendered only when the tenant's cod flag is ON in Console: the
            flag is the owner's switch, and the drawer must not advertise a
            payment path the server refuses. Gated on === true so a failed
            store-config fetch degrades to WhatsApp-only, never to a dead
            button. Every element below is null-guarded in the script. */}
        {storeConfig?.codEnabled === true && (
          <>
            <button type="button" id="cartCodBtn" class="btn btn-secondary cart-checkout-btn" style="margin-top:0.6rem;">Pay on Delivery 💵</button>
            <div id="codForm" style="display:none;margin-top:0.9rem;">
              <p class="cod-form-title">Delivery details</p>
              <input id="codName" class="cod-input" type="text" placeholder="Full name" autocomplete="name" />
              <input id="codPhone" class="cod-input" type="tel" placeholder="Phone (10 digits)" autocomplete="tel" />
              <input id="codEmail" class="cod-input" type="email" placeholder="Email (order updates)" autocomplete="email" />
              <input id="codAddress" class="cod-input" type="text" placeholder="Delivery address (flat, building, street)" autocomplete="street-address" />
              <div style="display:flex;gap:0.5rem;">
                <input id="codCity" class="cod-input" type="text" placeholder="City" autocomplete="address-level2" style="flex:1;min-width:0;" />
                <input id="codPincode" class="cod-input" type="text" inputmode="numeric" maxlength="6" placeholder="Pincode" autocomplete="postal-code" style="width:7.5rem;flex-shrink:0;" />
              </div>
              {/* State is derived from the pincode and stays EDITABLE: a handful of
                  PIN codes sit near a state border, and the invoice has to be right,
                  so the customer gets the last word rather than a readonly label. */}
              <select id="codState" class="cod-input" autocomplete="address-level1" aria-label="State">
                <option value="">Select state</option>
              </select>
              <p id="codStateMsg" class="cod-form-hint" style="display:none;"></p>
              <input id="codCoupon" class="cod-input" type="text" placeholder="Coupon code (optional)" autocomplete="off" />
              <div style="display:flex;gap:0.5rem;">
                <input id="codCredit" class="cod-input" type="text" placeholder="Store credit code (optional)" autocomplete="off" style="flex:1;min-width:0;" />
                <input id="codCreditAmount" class="cod-input" type="number" min="1" step="1" placeholder="₹ amount" aria-label="How much store credit to use" style="width:6.5rem;flex-shrink:0;" />
              </div>
              <p class="cod-form-hint">Store credit applies alongside a coupon, never instead of it. Leave the amount blank for the full balance.</p>
              <p id="codCreditMsg" class="cod-error" style="display:none;"></p>
              {/* Order-level note. For a cheese and char-grill store this is the field
                   that matters most: an allergy or a "no nut cross-contact" request
                   is a safety instruction, not a preference, and it has to reach the
                   kitchen. Per-item notes ride on the cart line itself (Console
                   stores them as order_items.line_notes); this is for anything about
                   the order as a whole. Reaches Console as orders.customer_note and
                   prints on the invoice, the packing slip AND the confirmation
                   email, so it is readable by whoever packs the box. */}
              <textarea id="codNote" class="cod-input" rows="3" maxlength="1000" style="resize:none;font-family:inherit;"
                placeholder="Allergies (nut, dairy, gluten), preparation instructions, delivery window, gift message (optional)"
                aria-label="Order note (optional) — allergies, preparation, delivery, gift message"></textarea>
              <p class="cod-form-hint">Tell us about allergies in this box — our kitchen prepares cheese and char-grill items, and nut cross-contact is a real risk. Per-item notes can be added to each line in the cart.</p>
              <div id="codOffers" style="display:none;" class="cod-offers">
                <p class="cod-offers-title">Available offers</p>
                <div id="codOffersList"></div>
              </div>
              <p id="codError" class="cod-error" style="display:none;"></p>
              <button type="button" id="codSubmit" class="btn btn-primary cart-checkout-btn">Place COD Order</button>
            </div>
            <div id="codSuccess" style="display:none;" class="cod-success">
              <p class="cod-success-title">Order placed! 🎉</p>
              <p>Order <strong id="codOrderNumber"></strong> · <strong id="codOrderTotal"></strong></p>
              <p class="cod-success-sub">Pay in cash or UPI when your box arrives. A confirmation is on its way to your email.</p>
            </div>
          </>
        )}
      
      <script type="application/json" id="crossSellData" set:html={JSON.stringify(crossSells)}></script></div>
    </div>
  </div>
  <div class="cart-backdrop" id="cartBackdrop"></div>

  <!-- Search overlay — live results from Console via /api/search proxy -->
  <div class="search-overlay" id="searchOverlay" role="dialog" aria-modal="true" aria-label="Search products">
    <div class="search-panel">
      <div class="search-row">
        <input type="search" id="searchInput" placeholder="Search the menu — jars, platters, balls…" autocomplete="off" />
        <button type="button" id="searchClose" aria-label="Close search">&times;</button>
      </div>
      <div id="searchResults" class="search-results"></div>
    </div>
  </div>

  <!-- Mobile Drawer Overlay — deliberately NOT nested inside <header>: that element has
       backdrop-filter, which creates a new containing block for position:fixed descendants
       and silently breaks fixed positioning relative to the viewport. -->
  <div class="mobile-drawer" id="mobileDrawer">
    <nav class="mobile-nav">
      <a href="/menu" class:list={['mobile-nav-item', { active: isActive('/menu') }]}>Menu</a>
      <a href="/byop" class:list={['mobile-nav-item', 'mobile-nav-byop', { active: isActive('/byop') }]}>✨ Build Your Platter (#BYOP)</a>
      <a href="/events" class:list={['mobile-nav-item', { active: isActive('/events') }]}>Events</a>
      <a href="/about" class:list={['mobile-nav-item', { active: isActive('/about') }]}>Our Story</a>
      <a href="/faq" class:list={['mobile-nav-item', { active: isActive('/faq') }]}>Delivery & FAQ</a>
      <a href="/account" class:list={['mobile-nav-item', { active: isActive('/account') }]}>My Account / Rewards</a>
      <div class="mobile-drawer-cta">
        <a href="/byop" class="btn btn-primary" style="width:100%">Start #BYOP Platter</a>
      </div>
    </nav>
  </div>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <div class="footer-brand">
        <a href="/" class="logo"><img src="/Logos/gobble-logo-tm-black.png" alt="Gobble by Pixie" class="logo-img" /></a>
        <p class="footer-tag">{content.tagline}</p>
        <div class="footer-badges">
          <span class="badge badge-veg">100% Vegetarian</span>
          <span class="badge badge-gf"><GlutenFreeIcon /> Gluten-Free</span>
          <span class="badge badge-keto">Keto-Friendly</span>
        </div>
      </div>

      <div class="footer-links">
        <div class="footer-col">
          <strong>Explore</strong>
          <a href="/menu">Full Catalog</a>
          <a href="/byop">Custom Platter (#BYOP)</a>
          <a href="/about">Our Artisanal Story</a>
        </div>
        <div class="footer-col">
          <strong>Help & Order</strong>
          <a href="/faq">Fulfillment Schedule</a>
          <a href="/account">My Account & Points</a>
          <a href="https://wa.link/sngzs9" target="_blank" rel="noopener">WhatsApp Direct Order</a>
          <a href="https://www.instagram.com/gobblebypixie/" target="_blank" rel="noopener">Instagram (@gobblebypixie)</a>
        </div>
      </div>

      <!-- First-bites list — upserts into Console's subscribers table
           (Settings → Newsletter), same endpoint as nanoliss.com -->
      <div class="footer-col footer-newsletter">
        <strong>First Bites</strong>
        <p class="footer-news-note">New flavours, seasonal platters, zero spam.</p>
        <form id="newsletterForm" novalidate>
          <div class="news-row">
            <input type="email" id="newsletterEmail" placeholder="Email address" autocomplete="email" required />
            <button type="submit" id="newsletterBtn" aria-label="Subscribe">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </button>
          </div>
          <p class="news-msg" id="newsletterMsg"></p>
        </form>
      </div>
    </div>

    <div class="container">
      <div class="footer-bottom">
        <p class="footer-note">Delivering fresh across Delhi, Gurgaon, Noida, Ghaziabad & Faridabad. Zero preservatives, always small-batch.</p>
        <p class="footer-legal">FSSAI Lic. No. {content.fssai_number} &nbsp;·&nbsp; GSTIN: {content.gstin}</p>
        <p class="copyright">&copy; {new Date().getFullYear()} Gobble by Pixie. All rights reserved.</p>
      </div>
    </div>
  </footer>

  <!-- Floating WhatsApp contact button — real product jar, bounces gently, with a WhatsApp badge so it clearly reads as "contact us" -->
  <a
    href="https://wa.link/sngzs9"
    target="_blank"
    rel="noopener"
    class="wa-fab"
    aria-label="Chat with Gobble by Pixie on WhatsApp"
  >
    <span class="wa-fab-face">
      <span class="wa-fab-ping"></span>
      <img src="/green-jar.png" alt="" class="wa-fab-jar" />
      <span class="wa-fab-chat-badge">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.9-4.45 9.9-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm5.8 14.13c-.24.68-1.4 1.3-1.93 1.38-.5.08-1.12.11-1.8-.11-.42-.14-.95-.32-1.64-.62-2.88-1.24-4.76-4.14-4.9-4.33-.14-.19-1.17-1.56-1.17-2.98 0-1.41.74-2.11 1-2.4.26-.29.57-.36.76-.36.19 0 .38 0 .55.01.18.01.41-.07.64.49.24.57.81 1.98.88 2.12.07.14.12.31.02.5-.09.19-.14.31-.28.48-.14.16-.29.36-.42.48-.14.14-.28.28-.12.55.16.28.71 1.17 1.53 1.9 1.05.94 1.94 1.23 2.21 1.37.28.14.44.12.6-.07.16-.19.69-.8.87-1.08.19-.28.37-.23.62-.14.26.09 1.63.77 1.91.91.28.14.47.21.54.33.07.12.07.68-.17 1.36z"/></svg>
      </span>
    </span>
  </a>

  <style>
    .fulfillment-banner {
      background: var(--text-espresso);
      color: #ffffff;
      text-align: center;
      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: 0.02em;
      padding: 0.6rem 1rem;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 0.6rem;
      flex-wrap: wrap;
    }
    .banner-divider { opacity: 0.6; }

    .site-header {
      /* 0.92 let big display headings ghost through as grey text while they
         scrolled underneath — read as a rendering bug, not a frost effect
         (owner report 2026-10-29). 0.98 keeps a whisper of translucency for
         the blur to act on; the ghosting is gone. */
      background: rgba(253, 251, 242, 0.98);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border-hairline);
      position: sticky;
      top: 0;
      z-index: 100;
    }
    .header-top {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      padding-top: var(--space-sm);
      padding-bottom: var(--space-sm);
      height: 92px;
    }
    .header-bottom {
      display: flex;
      align-items: center;
      justify-content: center;
      padding-bottom: 0.8rem;
    }
    .logo { grid-column: 2; justify-self: center; display: flex; align-items: center; }
    .logo-img { height: 68px; width: auto; display: block; }
    .footer-brand .logo-img { height: 44px; }

    .main-nav {
      display: flex;
      align-items: center;
      gap: var(--space-md);
    }
    .main-nav a {
      font-size: 0.92rem;
      font-weight: 600;
      color: var(--text-espresso-soft);
      transition: color 0.2s ease;
      position: relative;
    }
    .main-nav a:hover { color: var(--accent-berry); }
    .main-nav a::after {
      content: '';
      position: absolute;
      left: 0; right: 0; bottom: -6px;
      height: 2px;
      background: var(--accent-berry);
      border-radius: 2px;
      transform: scaleX(0);
      transition: transform 0.25s ease;
    }
    .main-nav a.active { color: var(--accent-berry); }
    .main-nav a.active::after,
    .main-nav a:hover::after { transform: scaleX(1); }
    .nav-byop {
      color: var(--accent-gold-deep) !important;
      background: var(--accent-gold-light);
      padding: 0.3rem 0.8rem;
      border-radius: var(--radius-pill);
      border: 1px solid rgba(232, 157, 23, 0.3);
    }
    .nav-byop:hover { background: var(--accent-gold); color: #ffffff !important; }
    .nav-byop.active { background: var(--accent-gold); color: #ffffff !important; }
    .nav-byop.active::after { display: none; }

    /* Dropdown */
    .dropdown {
      position: relative;
    }
    .dropdown-menu {
      position: absolute;
      top: 100%;
      left: 50%;
      transform: translateX(-50%) translateY(10px);
      background: var(--bg-parchment);
      border: 1px solid var(--border-hairline);
      border-radius: var(--radius-sm);
      box-shadow: var(--shadow-ambient-lg);
      padding: 0.5rem 0;
      min-width: 180px;
      opacity: 0;
      visibility: hidden;
      transition: all 0.2s ease;
      z-index: 100;
    }
    .dropdown:hover .dropdown-menu {
      opacity: 1;
      visibility: visible;
      transform: translateX(-50%) translateY(0);
    }
    .dropdown-menu a {
      display: block;
      padding: 0.5rem 1rem;
      font-size: 0.85rem;
