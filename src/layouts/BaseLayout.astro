    // Longest prefix first: "403" (Goa) must be tested before "40"
    // (Maharashtra), or a Goa customer is invoiced in the wrong state.
    COD_PIN_PREFIX.sort((a, b) => b[0].length - a[0].length);

    const codStateSel = document.getElementById('codState') as HTMLSelectElement | null;
    const codPinEl = document.getElementById('codPincode') as HTMLInputElement | null;
    const codStateMsg = document.getElementById('codStateMsg');

    if (codStateSel) {
      for (const s of COD_STATES) {
        const opt = document.createElement('option');
        opt.value = s.state;
        opt.textContent = s.state;
        codStateSel.appendChild(opt);
      }
    }

    function codApplyPinState() {
      if (!codStateSel || !codPinEl) return;
      const pin = codPinEl.value.replace(/\D/g, '');
      if (codStateMsg) codStateMsg.style.display = 'none';
      if (pin.length !== 6) return;
      const hit = COD_PIN_PREFIX.find(([p]) => pin.startsWith(p));
      if (!hit) {
        // Do NOT block: an unrecognised pincode just means we ask.
        if (codStateMsg) {
          codStateMsg.textContent = 'We could not match that pincode to a state — please pick one.';
          codStateMsg.style.display = 'block';
        }
        return;
      }
      codStateSel.value = hit[1].state;
      if (codStateMsg) {
        codStateMsg.textContent = `State set from pincode: ${hit[1].state}. Change it if that is wrong.`;
        codStateMsg.style.display = 'block';
      }
    }

    codPinEl?.addEventListener('input', codApplyPinState);
    codPinEl?.addEventListener('blur', codApplyPinState);
    // Once the customer picks a state themselves, stop arguing with them.
    codStateSel?.addEventListener('change', () => {
      if (codStateMsg) codStateMsg.style.display = 'none';
    });

    cartCodBtn?.addEventListener('click', () => {
      if (!codForm) return;
      const open = codForm.style.display !== 'none';
      codForm.style.display = open ? 'none' : 'block';
      if (codError) codError.style.display = 'none';
      if (codSuccess) codSuccess.style.display = 'none';
      // Offers depend on the live cart — refresh each time the form opens.
      if (!open) {
        refreshCodOffers();
        // The form lives in the footer's own scroll container (it is taller
        // than the drawer). Bring its top field into view on open, or on a
        // short screen the customer sees the summary and a dead scroll.
        codForm.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    });

    codSubmit?.addEventListener('click', async () => {
      if (codError) codError.style.display = 'none';
      const items = window.GobbleCart ? window.GobbleCart.get() : [];
      if (!items.length) return codShowError('Your cart is empty.');
      // Works for <input>, <textarea> AND <select> — every one of them exposes
    // .value as a string, so the narrow cast was never needed and only invited
    // the reader to doubt the select case.
    const val = (id: string) =>
      (document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null)?.value?.trim() || '';
      const customer = {
        name: val('codName'),
        phone: val('codPhone'),
        email: val('codEmail'),
        address: val('codAddress'),
        city: val('codCity'),
        pincode: val('codPincode'),
        state: val('codState'),
      };
      const couponCode = val('codCoupon') || undefined;
      // Store credit rides alongside the coupon — Console owns the balance,
      // validates it as credit, and sums it into the discount. Re-validated
      // server-side at submit, so the preview above can never charge wrong.
      const creditCode = val('codCredit').toUpperCase() || undefined;
      const creditRaw = val('codCreditAmount');
      const creditAmount = creditRaw === '' ? undefined : Number(creditRaw);
      if (codSubmit) { codSubmit.disabled = true; codSubmit.textContent = 'Placing order…'; }
      try {
        const res = await fetch('/api/checkout/cod', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            // `note` rides along: the cart line's own instruction (allergies,
            // "extra nut isolation", platter preferences). Dropping it here
            // meant the customer saw their note in the drawer and the kitchen
            // received nothing. /byop composes the same field.
            items: items.map((i: any) => ({
              slug: i.id,
              qty: i.qty || 1,
              ...(typeof i.note === 'string' && i.note.trim() ? { note: i.note.trim() } : {}),
            })),
            customer,
            customerNote: val('codNote') || undefined,
            couponCode,
            creditCode,
            creditAmount,
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.success) {
          codShowError(data.error || 'Could not place the order. Please try again.');
          return;
        }
        // Real order now exists in Console (stock decremented, totals
        // server-priced) — the local cart must go, or a refresh would
        // re-sell the same box.
        window.GobbleCart.clear();
        if (codForm) codForm.style.display = 'none';
        const num = document.getElementById('codOrderNumber');
        const tot = document.getElementById('codOrderTotal');
        if (num) num.textContent = '#' + data.orderNumber;
        if (tot) tot.textContent = formatPrice(data.total);
        if (codSuccess) codSuccess.style.display = 'block';
      } catch {
        codShowError('Network error — please check your connection.');
      } finally {
        if (codSubmit) { codSubmit.disabled = false; codSubmit.textContent = 'Place COD Order'; }
      }
    });

    // ── Store credit preview + live offers ──
    // The credit box is validated live (debounced) so a promo code typed
    // here says "That is a promo code, not store credit." at the box — not
    // at order submit. The preview is display-only: submit re-sends the raw
    // fields and Console re-validates authoritatively, so a stale preview
    // can never charge a wrong total.
    let creditCheckTimer: ReturnType<typeof setTimeout> | null = null;
    let creditCheckSeq = 0;
    function cartPreviewTotal(): number {
      try {
        const items = window.GobbleCart ? window.GobbleCart.get() : [];
        return items.reduce((s: number, i: any) => s + (Number(i.price) || 0) * (i.qty || 1), 0);
      } catch { return 0; }
    }
    function showCreditMsg(msg: string) {
      const el = document.getElementById('codCreditMsg');
      if (!el) return;
      el.textContent = msg;
      el.style.display = msg ? 'block' : 'none';
    }
    function renderCreditPreview(code: string | null, amount: number) {
      const row = document.getElementById('cartCreditRow');
      const label = document.getElementById('cartCreditLabel');
      const line = document.getElementById('cartCreditAmountLine');
      if (!row || !label || !line) return;
      if (code && amount > 0) {
        label.textContent = 'Store credit (' + code + ')';
        line.textContent = '−' + formatPrice(amount);
        row.style.display = '';
      } else {
        row.style.display = 'none';
      }
    }
    async function checkCredit() {
      const codeEl = document.getElementById('codCredit') as HTMLInputElement | null;
      const amtEl = document.getElementById('codCreditAmount') as HTMLInputElement | null;
      const emailEl = document.getElementById('codEmail') as HTMLInputElement | null;
      const code = (codeEl?.value || '').trim().toUpperCase();
      showCreditMsg('');
      renderCreditPreview(null, 0);
      if (!code) return;
      const rawAmount = (amtEl?.value || '').trim();
      const requested = rawAmount === '' ? undefined : Number(rawAmount);
      if (rawAmount !== '' && (!isFinite(requested as number) || (requested as number) <= 0)) {
        showCreditMsg('Enter an amount, or leave blank for the full balance.');
        return;
      }
      const seq = ++creditCheckSeq;
      try {
        const res = await fetch('/api/coupons/validate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            code,
            cartTotal: cartPreviewTotal(),
            customerEmail: (emailEl?.value || '').trim() || undefined,
          }),
        });
        if (seq !== creditCheckSeq) return;
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.valid) {
          showCreditMsg(data.error || 'Invalid store credit code.');
          return;
        }
        if (data.kind !== 'credit') {
          showCreditMsg('That is a promo code, not store credit.');
          return;
        }
        const available = Number(data.creditAvailable || 0);
        const spend = requested ?? available;
        if (!(spend > 0)) {
          showCreditMsg('This store credit has already been used.');
          return;
        }
        renderCreditPreview(data.code || code, Math.min(spend, available, cartPreviewTotal()));
      } catch {
        // Preview only — submit re-validates. Stay silent, not wrong.
      }
    }
    function queueCreditCheck() {
      if (creditCheckTimer) clearTimeout(creditCheckTimer);
      creditCheckTimer = setTimeout(checkCredit, 800);
    }
    ['codCredit', 'codCreditAmount', 'codEmail'].forEach((id) => {
      document.getElementById(id)?.addEventListener('input', queueCreditCheck);
    });

    // Live offers (Console /api/coupons/best). Renders nothing when the
    // tenant has no live promos — correct for a store that doesn't discount.
    async function refreshCodOffers() {
      const box = document.getElementById('codOffers');
      const list = document.getElementById('codOffersList');
      if (!box || !list) return;
      const total = cartPreviewTotal();
      if (!total) { box.style.display = 'none'; return; }
      try {
        const email = (document.getElementById('codEmail') as HTMLInputElement | null)?.value.trim() || '';
        const params = new URLSearchParams({ cartTotal: String(total) });
        if (email) params.set('customerEmail', email);
        const res = await fetch('/api/coupons/best?' + params.toString());
        const data = await res.json().catch(() => ({}));
        const offers = Array.isArray(data.offers) ? data.offers.filter((o: any) => o && o.code).slice(0, 4) : [];
        if (!offers.length) { box.style.display = 'none'; return; }
        list.innerHTML = '';
        offers.forEach((o: any) => {
          const row = document.createElement('div');
          row.className = 'cod-offer-row';
          const desc = o.discountPercent ? o.discountPercent + '% off' : (o.discountAmount ? '₹' + o.discountAmount + ' off' : 'Offer');
          const info = document.createElement('div');
          const codeEl = document.createElement('span');
          codeEl.className = 'cod-offer-code';
          codeEl.textContent = o.code;
          const descEl = document.createElement('div');
          descEl.className = 'cod-offer-desc';
          descEl.textContent = desc;
          info.appendChild(codeEl);
          info.appendChild(descEl);
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'cod-offer-apply';
          btn.textContent = 'Apply';
          btn.addEventListener('click', () => {
            const input = document.getElementById('codCoupon') as HTMLInputElement | null;
            if (input) input.value = o.code;
          });
          row.appendChild(info);
          row.appendChild(btn);
          list.appendChild(row);
        });
        box.style.display = 'block';
      } catch {
        box.style.display = 'none';
      }
    }
    // ── Abandoned-cart capture (Console recovery cron) ──
    // Same contract as Nanoliss/TCS: POST once we have an email, deduped by
    // cart signature, at most every 60s, best-effort. The COD form email is
    // the capture point — the drawer itself never sees an address.
    let lastCartSaveKey = "";
    let lastCartSaveAt = 0;
    function saveAbandonedCart() {
      try {
        const emailEl = document.getElementById('codEmail') as HTMLInputElement | null;
        const email = (emailEl?.value || '').trim();
        const items = window.GobbleCart ? window.GobbleCart.get() : [];
        if (!email || email.indexOf('@') < 0 || !items.length) return;
        const key = email + '|' + items.map((i: any) => i.id + 'x' + (i.qty || 1)).join(',');
        if (key === lastCartSaveKey || Date.now() - lastCartSaveAt < 60000) return;
        lastCartSaveKey = key;
        lastCartSaveAt = Date.now();
        const nameEl = document.getElementById('codName') as HTMLInputElement | null;
        fetch('/api/cart/save', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email,
            name: (nameEl?.value || '').trim() || undefined,
            items: items.map((i: any) => ({ slug: i.id, name: i.name, price: i.price, qty: i.qty || 1, image: i.image })),
            total: window.GobbleCart.total(),
          }),
        }).catch(() => {});
      } catch {}
    }

    document.getElementById('codEmail')?.addEventListener('input', saveAbandonedCart);

    // ── Search overlay (Console-backed via /api/search) ──
    const searchOverlay = document.getElementById('searchOverlay');
    const searchInput = document.getElementById('searchInput') as HTMLInputElement | null;
    const searchResults = document.getElementById('searchResults');
    let searchTimer: ReturnType<typeof setTimeout> | undefined;

    function openSearch() {
      searchOverlay?.classList.add('open');
      document.body.style.overflow = 'hidden';
      setTimeout(() => searchInput?.focus(), 30);
    }
    function closeSearch() {
      searchOverlay?.classList.remove('open');
      document.body.style.overflow = '';
    }
    document.getElementById('searchToggle')?.addEventListener('click', openSearch);
    document.getElementById('searchClose')?.addEventListener('click', closeSearch);
    searchOverlay?.addEventListener('click', (e) => { if (e.target === searchOverlay) closeSearch(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && searchOverlay?.classList.contains('open')) closeSearch(); });

    function fmtPrice(p: unknown): string {
      return typeof p === 'number' && p > 0
        ? '₹' + p.toLocaleString('en-IN')
        : 'Price on request';
    }

    searchInput?.addEventListener('input', () => {
      clearTimeout(searchTimer);
      const q = (searchInput.value || '').trim();
      if (q.length < 2) { if (searchResults) searchResults.innerHTML = ''; return; }
      searchTimer = setTimeout(async () => {
        if (!searchResults) return;
        try {
          const res = await fetch('/api/search?q=' + encodeURIComponent(q));
          const data = await res.json();
          const results = data.results || [];
          if (!results.length) {
            searchResults.innerHTML = '<p class="search-empty">Nothing in the case for “' + escapeHtml(q) + '”.</p>';
            return;
          }
          searchResults.innerHTML = results.map((r: any) =>
            // Real link to the product. This was <button data-href="/menu">:
            // every result pointed at the menu listing and nothing ever read
            // data-href, so clicking a result did literally nothing. The
            // Console's /api/public/search returns `slug`, and the product
            // route is /products/<slug>/ (verified: all 44 product URLs this
            // site advertises return 200).
            '<a class="search-hit" href="/products/' + escapeHtml(String(r.slug || r.id || '')) + '/">'
            + (r.image ? '<img src="' + escapeHtml(String(r.image)) + '" alt="" loading="lazy" />' : '<img src="/green-jar.png" alt="" />')
            + '<span><span class="search-hit-name">' + escapeHtml(String(r.name ?? '')) + '</span><br/>'
            + '<span class="search-hit-meta">' + fmtPrice(r.price) + '</span></span></a>'
          ).join('');
        } catch {
          if (searchResults) searchResults.innerHTML = '<p class="search-empty">Search is unavailable right now.</p>';
        }
      }, 250);
    });

    // ── Footer newsletter → Console subscribers (/api/newsletter) ──
    const newsletterForm = document.getElementById('newsletterForm') as HTMLFormElement | null;
    const newsletterMsg = document.getElementById('newsletterMsg');
    newsletterForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const input = document.getElementById('newsletterEmail') as HTMLInputElement | null;
      const email = (input?.value || '').trim();
      if (!email || !email.includes('@')) { if (newsletterMsg) { newsletterMsg.textContent = 'Enter a valid email.'; newsletterMsg.style.opacity = '1'; } return; }
      try {
        const res = await fetch('/api/newsletter', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.ok !== false) {
          if (newsletterMsg) newsletterMsg.textContent = "You're on the First Bites list.";
          newsletterForm.reset();
        } else {
          if (newsletterMsg) newsletterMsg.textContent = data.error || 'Could not subscribe right now.';
        }
      } catch {
        if (newsletterMsg) newsletterMsg.textContent = 'Network error — try again.';
      }
    });
  </script>

  <!-- Console live-draft (Settings → Content "Vision"): when this page is
       iframed by the Console content editor (?livedraft=1), unsaved copy
       edits stream in via postMessage and patch the [data-lc] hooks, and
       [data-lc] elements become click-to-edit — typing streams back to the
       Console form via postMessage (lc-content-edit). Inert for normal
       visitors (no query param, no listeners). -->
  <script is:inline>
    (function () {
      if (new URLSearchParams(location.search).get('livedraft') !== '1') return;
      var PAGE = { '/': 'home', '/about': 'about', '/preview-sections': 'sections' }[location.pathname] || '';

      // ── Navigate-follow (Item 7a) ──────────────────────────────────────
      // The Console tells us which paths it has editors for. We intercept ONLY
      // those and hand the intent back via lc-navigate; every other link
      // navigates normally, so this stays a working browser for cart, account,
      // /menu, /events, /faq and the rest. Defaults empty, so an older Console
      // that never sends lc-editable intercepts nothing — exactly today's
      // behaviour.
      //
      // Note there is no /contact in the map above and none in the Console's
      // editable list either: Gobble has no contact page, so the Console hides
      // that tab for food tenants. The interception is driven purely by the
      // list the Console sends, so the two can never drift.
      var EDITABLE = [];

      // Must agree with the Console's normPath (src/lib/vision-paths.ts):
      // strip query/hash, decode, force a leading slash, drop any trailing
      // slash, lowercase. Our own section CTAs carry an arbitrary href
      // (HomeSections.astro falls back to '#'), which the guards below skip.
      function lcNormPath(p) {
        var s = String(p || '/');
        var cut = s.search(/[?#]/);
        if (cut >= 0) s = s.slice(0, cut);
        try { s = decodeURI(s); } catch (err) {}
        if (s.charAt(0) !== '/') s = '/' + s;
        if (s.length > 1) s = s.replace(/\/+$/, '');
        return s.toLowerCase() || '/';
      }

      document.body.classList.add('lc-live');
      var style = document.createElement('style');
      style.textContent =
        '.lc-live [data-lc]{cursor:text;outline:1px dashed transparent;transition:outline-color .15s}' +
        '.lc-live [data-lc]:hover{outline-color:rgba(37,99,235,.55)}' +
        '.lc-live [data-lc]:focus{outline:2px solid rgba(37,99,235,.85);outline-offset:2px}';
      document.head.appendChild(style);

      document.querySelectorAll('[data-lc]').forEach(function (el) {
        var hook = el.getAttribute('data-lc');
        // Image hooks are receive-only (Item 6b): no text to edit, and making
        // an <img> contenteditable lets a stray input event clear the Console
        // field with an empty value. Report a click instead so the Console
        // opens its image picker for this hook.
        if (el.tagName === 'IMG') {
          el.addEventListener('click', function (e) {
            e.preventDefault();
            parent.postMessage({ type: 'lc-content-edit', id: hook, value: el.getAttribute('src') || '' }, '*');
          });
          return;
        }
        el.setAttribute('contenteditable', 'plaintext-only');
        if (!el.isContentEditable) el.setAttribute('contenteditable', 'true');
        el.addEventListener('click', function (e) {
          if (el.closest('a')) e.preventDefault();
        });
        el.addEventListener('input', function () {
          parent.postMessage({ type: 'lc-content-edit', id: hook, value: el.innerText }, '*');
        });
      });

      window.addEventListener('message', function (e) {
        var d = e.data || {};
        // The Console's editable-path list (Item 7a). Handled in this same
        // listener rather than adding a second one on window.
        if (d.type === 'lc-editable' && d.paths) {
          EDITABLE = Array.prototype.slice.call(d.paths);
          return;
        }
        if (d.type !== 'lc-content-preview' || !d.patch) return;
        var applied = [];
        document.querySelectorAll('[data-lc]').forEach(function (el) {
          if (document.activeElement === el) return; // never clobber the caret mid-edit
          var key = el.getAttribute('data-lc');
          var v = d.patch[key];
          if (v === undefined || v === null) return;
          // Image hooks (Item 6b) — patch src, never textContent: writing
          // text into an <img> is a silent no-op. Mirrors the branch TCS
          // already had.
          if (el.tagName === 'IMG') {
            if (v) el.src = String(v);
          } else {
            el.textContent = String(v);
          }
          applied.push(key);
        });
        // Ack so the Console's "live" indicator can confirm a patch LANDED.
        // Additive: an older Console ignores this type.
        if (applied.length && window.parent !== window) {
          for (var i = 0; i < applied.length; i++) {
            parent.postMessage({ type: 'lc-applied', key: applied[i] }, '*');
          }
        }
      });
      // ── Navigate-follow: intercept ONLY the paths the Console said it can edit.
      // Capture phase so it runs before any component handler, but we never
      // stopPropagation: the product grid is quick-view MODAL buttons rather
      // than links, and their handlers must keep working.
      document.addEventListener('click', function (e) {
        var t = e.target;
        if (!t || !t.closest) return;
        // Editing wins over navigating — clicking editable text must place a
        // caret, not leave the page.
        if (t.closest('[data-lc]')) return;
        // A control nested INSIDE a link owns its own click. The quick-view
        // button on every product card is one of these.
        if (t.closest('button,[role=button],input,select,textarea')) return;
        var a = t.closest('a[href]');
        if (!a) return;
        if (a.hasAttribute('download') || a.target === '_blank') return;
        var href = a.getAttribute('href') || '';
        // '#' is how HomeSections renders an unset section CTA.
        if (!href || href.charAt(0) === '#') return;
        if (/^(https?:)?\/\//i.test(href)) return;
        if (/^(mailto:|tel:|sms:|javascript:)/i.test(href)) return;
        var norm = lcNormPath(href);
        // Not ours — let the browser navigate. This is the safety property:
        // we never preventDefault a click the Console cannot service. It is
        // what leaves /menu, /events, /faq, /byop and /account working.
        if (EDITABLE.indexOf(norm) === -1) return;
        e.preventDefault();
        if (window.parent !== window) {
          parent.postMessage({ type: 'lc-navigate', path: norm }, '*');
        }
      }, true);

      // `path` is new in this handshake (Item 7a): it lets the Console see a
      // navigation it did NOT intercept and say so, instead of the panel
      // going blank on a page it has no editor for.
      parent.postMessage(
        { type: 'lc-content-ready', page: PAGE, path: lcNormPath(location.pathname) },
        '*',
      );
    })();
  </script>
</body>
</html>

