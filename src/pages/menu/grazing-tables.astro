---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fetchProducts, getCategories, slugify } from '../../lib/fetchProducts.js';
import { fetchSiteContent } from '../../lib/fetchSiteContent.js';

const products = await fetchProducts();
const allCategories = getCategories(products);
const content = await fetchSiteContent();
const WA = 'https://wa.link/sngzs9';
---
<BaseLayout title="Grazing Tables — Gobble by Pixie">
  <section class="menu-hero">
    <div class="container">
      <p class="eyebrow">Artisanal Catalog</p>
      <h1>Grazing Tables</h1>
      <p class="section-sub">For big celebrations — weddings, corporate parties, milestone moments.</p>
    </div>
  </section>

  <div class="category-subnav">
    <div class="container">
      <nav class="subnav-links">
        {allCategories.map((c) => <a href={`/menu/${slugify(c)}`} class="subnav-link">{c}</a>)}
        <a href="/menu/grazing-tables" class="subnav-link active">Grazing Tables</a>
      </nav>
    </div>
  </div>

  <section class="menu-body">
    <div class="container">
      <div class="card special-card grazing-card">
        <p class="eyebrow">For Big Celebrations</p>
        <h3>Grazing Table for Parties</h3>
        <p class="grazing-price">{content.grazing_table_price}</p>
        <p>A full spread grazing table designed for your event — weddings, corporate parties, milestone celebrations. Every table is custom-built around your guest count, theme, and budget.</p>
        <a href={`${WA}?text=${encodeURIComponent("Hi! I'd like to enquire about a Grazing Table for a party. Could you share more details?")}`} target="_blank" rel="noopener" class="btn btn-primary">Enquire on WhatsApp</a>
      </div>
    </div>
  </section>

  <style>
    .menu-hero { text-align: center; padding-bottom: var(--space-md); }
    .section-sub { max-width: 52ch; margin: 0 auto; color: var(--text-espresso-soft); font-size: 1.05rem; }

    .category-subnav {
      position: sticky;
      top: 117px;
      z-index: 90;
      background: rgba(247, 240, 231, 0.95);
      backdrop-filter: blur(12px);
      padding: var(--space-sm) 0;
      border-bottom: 1px solid var(--border-hairline);
    }
    @media (max-width: 820px) {
      .category-subnav { top: 82px; }
    }
    .subnav-links {
      display: flex;
      gap: 1.5rem;
      justify-content: center;
      min-width: max-content;
      overflow-x: auto;
      padding-bottom: 0.2rem;
    }
    .subnav-link {
      font-family: var(--font-display);
      font-weight: 600;
      font-size: 1.1rem;
      color: var(--text-espresso-soft);
      white-space: nowrap;
      transition: color 0.2s ease;
    }
    .subnav-link:hover, .subnav-link.active {
      color: var(--rose-deep);
    }

    .menu-body { padding-top: var(--space-lg); }
    .special-card { padding: var(--space-lg); text-align: center; max-width: 600px; margin: 0 auto; }
    .special-card p { color: var(--text-espresso-soft); }
    .grazing-card { background: linear-gradient(150deg, rgba(232,157,23,0.1), var(--bg-parchment)); }
    .grazing-price { font-family: var(--font-display); font-size: 1.8rem; font-weight: 700; color: var(--text-espresso); }

    @media (max-width: 600px) {
      .subnav-links { justify-content: flex-start; }
    }
  </style>
</BaseLayout>
