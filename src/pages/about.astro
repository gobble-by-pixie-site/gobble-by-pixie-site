---
import BaseLayout from '../layouts/BaseLayout.astro';
import { fetchSiteContent } from '../lib/fetchSiteContent.js';
import { fetchFromConsole } from '../lib/console-client.js';

const content = await fetchSiteContent();

// Owner-editable About copy (Console → Settings → Content → About).
// Falls back to the hand-written page copy for any missing field / failed
// fetch, so a blank Console row renders exactly what shipped before wiring.
// (Build-time fetch — this is a static site; saved edits appear on rebuild.)
const savedAbout = await fetchFromConsole('/api/public/site-content/about').catch(() => null);
const aboutCopy = {
  eyebrow: savedAbout?.eyebrow || 'The Artisanal Philosophy',
  heading: savedAbout?.heading || '',
  intro: content.about_intro,
  values:
    Array.isArray(savedAbout?.values) && savedAbout.values.length
      ? savedAbout.values
      : [
          { title: 'Zero Preservatives', description: 'Nothing artificial, ever. What you taste is pure, authentic cream cheese made from natural ingredients.' },
          { title: 'Small-Batch Craft', description: 'Handcrafted fresh in small batches to preserve rich creaminess and fearless flavour profiles.' },
          { title: 'Delhi NCR Doorstep', description: 'Delivered direct from our kitchen across Delhi, Gurgaon, Noida, Ghaziabad & Faridabad.' },
        ],
};
const valueIcons = ['🌿', '🧀', '🚀'];
const valueThemes = ['card-gold', 'card-coral', 'card-teal'];
---
<BaseLayout title="Our Story — Gobble by Pixie">
  <section class="about-hero">
    <div class="container about-grid">
      <div class="about-image-wrap card">
        <div class="about-image" style="background-image: url('https://images.unsplash.com/photo-1631206753348-db44968fd440?w=1000&q=80')"></div>
      </div>
      <div class="about-copy">
        <p class="eyebrow" data-lc="about:eyebrow">{aboutCopy.eyebrow}</p>
        {aboutCopy.heading ? (
          <h1 data-lc="about:heading">{aboutCopy.heading}</h1>
        ) : (
          <h1>Made with love, <span class="text-gradient">never shortcuts</span></h1>
        )}
        <p data-lc="about:story:0">{aboutCopy.intro}</p>
        <p>We're gluten-free and keto-friendly by design, not as an afterthought — so everyone around the table can gobble without compromise.</p>
      </div>
    </div>
  </section>

  <section class="values">
    <div class="container">
      <div class="values-header">
        <p class="eyebrow">Why Choose Pixie</p>
        <h2>Our Uncompromising Standards</h2>
      </div>

      <div class="values-grid">
        {aboutCopy.values.map((v, i) => (
          <div class={`value-card card ${valueThemes[i % valueThemes.length]}`}>
            <span class="value-icon">{valueIcons[i % valueIcons.length]}</span>
            <h3 data-lc={`about:values:${i}:title`}>{v.title}</h3>
            <p data-lc={`about:values:${i}:description`}>{v.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <style>
    .about-hero { padding-bottom: var(--space-xl); }
    .about-grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: var(--space-xl); align-items: center; }
    .about-image-wrap { padding: 10px; border-radius: var(--radius-lg); }
    .about-image { height: 440px; border-radius: calc(var(--radius-lg) - 6px); background-size: cover; background-position: center; }
    .about-copy p { font-size: 1.05rem; color: var(--text-espresso-soft); line-height: 1.6; }

    .values { background: var(--bg-parchment-alt); border-top: 1px solid var(--border-hairline); }
    .values-header { text-align: center; max-width: 500px; margin: 0 auto var(--space-lg); }
    .values-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-md); }
    
    .value-card { padding: var(--space-lg) var(--space-md); text-align: center; border-top: 4px solid var(--accent-gold); }
    .card-gold { border-top-color: var(--accent-gold); }
    .card-coral { border-top-color: var(--accent-coral); }
    .card-teal { border-top-color: var(--accent-teal); }
    
    .value-icon { font-size: 2.2rem; display: block; margin-bottom: 0.6rem; }
    .value-card h3 { font-size: 1.25rem; font-family: var(--font-display); margin-bottom: 0.4rem; }
    .value-card p { font-size: 0.9rem; color: var(--text-muted); margin: 0; }

    @media (max-width: 860px) {
      .about-grid { grid-template-columns: 1fr; }
      .about-image-wrap { order: -1; }
      .about-image { height: 300px; }
      .values-grid { grid-template-columns: 1fr; }
    }
  </style>
</BaseLayout>

