---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PHONE_COUNTRIES } from '../lib/phone-countries.js';

const tiers = [
  { name: 'Nibbler', range: 'From your first order', color: 'var(--tag-sage)', perks: 'Free account • Early access to seasonal artisanal flavours' },
  { name: 'Foodie', range: 'Lifetime-spend tier', color: 'var(--accent-gold-deep)', perks: 'Everything in Nibbler • Lifetime-spend tier rises as you spend' },
  { name: 'Gobbler VIP', range: 'Lifetime-spend tier', color: 'var(--accent-berry)', perks: 'Everything in Foodie • First access to new handcrafted drops & #BYOP specials' },
];

const earnRules = [
  ['Create an account', '100 pts', 'Instant bonus on signup'],
  ['Every order', '1 pt per ₹100', 'Automatic on payment'],
  ['Refer a friend', '150 pts', 'Unlocks soon'],
];
---
<BaseLayout title="My Account — Gobble by Pixie" description="Your orders and Gobble Rewards.">

  <!-- Not logged in Gate -->
  <div id="auth-gate" class="container auth-gate" style="display:none;">
    <div class="card auth-gate-card">
      <p class="eyebrow">✨ Gobble Rewards Club</p>
      <h1>Sign in to see your rewards</h1>
      <p id="session-expired-notice" class="session-notice" style="display:none;">Your session has expired — please sign in again.</p>
      <p class="auth-gate-sub">Track your handcrafted orders, earn points on every platter, and unlock exclusive VIP discounts.</p>
      <div class="auth-gate-ctas">
        <a href="/login" class="btn btn-primary">Sign In</a>
        <a href="/signup" class="btn btn-secondary">Create Free Account (100 pts bonus)</a>
      </div>
    </div>
  </div>

  <!-- Logged in Content -->
  <div id="acct-content-wrap" style="display:none;">
    <section class="acct-header">
      <div class="container acct-header-inner card">
        <div class="user-greeting">
          <p class="eyebrow">Welcome Back</p>
          <h1 id="acct-greeting">Hello.</h1>
          <p class="greeting-sub">Manage your profile, view orders, and redeem Gobble Rewards.</p>
        </div>
        <div id="acct-points-badge" class="points-badge" style="display:none;">
          <div id="tier-badge" class="tier-badge"></div>
          <p id="points-display" class="points-display text-gradient-gold">0</p>
          <p class="points-label">Gobble Reward Points</p>
        </div>
      </div>
    </section>

    <div class="tabs-bar">
      <div class="container tabs-inner">
        {['Profile', 'Orders', 'Rewards', 'Addresses'].map((tab) => (
          <button class="tab-btn" data-tab={tab.toLowerCase()}>{tab}</button>
        ))}
      </div>
    </div>

    <div class="container tab-content">
      <!-- PROFILE TAB -->
      <div id="tab-profile" class="tab-pane" style="display:none;">
        <div class="card pane-card">
          <h3>Your Profile Details</h3>
          <div class="profile-grid">
            <div><label class="field-label">Full Name</label><input id="p-name" type="text" class="text-field" /></div>
            <div><label class="field-label">Email</label><input id="p-email" type="email" class="text-field" readonly /></div>
            <div><label class="field-label">Phone</label><span style="display:flex;gap:0.5rem;flex-wrap:wrap;"><select id="p-dial" class="text-field" style="width:9.5rem;flex:none;" aria-label="Phone country">{PHONE_COUNTRIES.map((c) => (<option value={c.dial} selected={c.dial === '91'}>{c.flag} {c.shortName} +{c.dial}</option>))}</select><input id="p-phone" type="tel" class="text-field" style="flex:1;min-width:0;" /></span></div>
          <div><label class="field-label">Birthday <span style="font-weight:400;color:var(--text-muted)">(optional — we send a little something)</span></label><input id="p-birthday" type="date" class="text-field" /></div>
          <label style="display:flex;align-items:center;gap:0.5rem;font-size:0.85rem;color:var(--text-espresso-soft)"><input id="p-consent" type="checkbox" /> Email me offers and new arrivals (unsubscribe any time)</label>
            <div class="profile-actions">
              <button id="save-profile-btn" class="btn btn-primary">Save Profile Changes</button>
              <p id="profile-saved-msg" class="saved-msg" style="display:none;">✓ Profile saved successfully</p>
            </div>
            <div class="signout-row">
              <div id="password-section" data-has-password="">
            <p class="field-label">Password</p>
            <p id="password-desc" style="margin:0.25rem 0 0.6rem;font-size:0.85rem;color:var(--text-muted);">Want a new password? Send a reset link to your email to change it.</p>
            <button id="pwd-btn" class="btn btn-outline" type="button">Email me a reset link</button>
            <p id="pwd-msg" style="display:none;margin:0.5rem 0 0;font-size:0.82rem;"></p>
          </div>

          <button id="signout-btn" class="signout-link">Sign out of this device</button>
            </div>
          </div>
        </div>
      </div>

      <!-- ORDERS TAB -->
      <div id="tab-orders" class="tab-pane" style="display:none;">
        <div id="orders-list"></div>
      </div>

      <!-- ADDRESSES TAB — Console is the store; the wishlist/orders/rewards
           tabs are unchanged, this one is the nanoliss-parity account surface. -->
      <div id="tab-addresses" class="tab-pane" style="display:none;">
        <div class="card pane-card">
          <h3>Shipping Addresses</h3>
          <div id="addr-list" style="margin: var(--space-md) 0;"></div>
          <p style="margin:0 0 0.6rem;font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:var(--text-muted);">Add a new address</p>
          <div class="profile-grid" style="max-width:none;">
            <div style="grid-column: span 2;">
              <label class="field-label">Address Line 1</label>
              <input id="a-line1" type="text" class="text-field" placeholder="House no., street" autocomplete="address-line1" />
            </div>
            <div style="grid-column: span 2;">
              <label class="field-label">Address Line 2 (optional)</label>
              <input id="a-line2" type="text" class="text-field" placeholder="Landmark, area" autocomplete="address-line2" />
            </div>
            <div>
              <label class="field-label">PIN Code</label>
              <input id="a-pincode" type="text" inputmode="numeric" maxlength="6" class="text-field" placeholder="e.g. 110001" autocomplete="postal-code" />
              <p id="a-pincode-status" style="display:none;margin:0.25rem 0 0;font-size:0.78rem;color:var(--text-muted);"></p>
            </div>
            <div>
              <label class="field-label">Country</label>
              <select id="a-country" class="text-field">
                <option value="India">India</option>
                <option value="Other">Other</option>
              </select>
            </div>
            <div>
              <label class="field-label">City</label>
              <input id="a-city" type="text" class="text-field" autocomplete="address-level2" />
            </div>
            <div>
              <label class="field-label">State</label>
              <input id="a-state" type="text" class="text-field" autocomplete="address-level1" />
            </div>
          </div>
          <div class="profile-actions" style="grid-column: span 2;">
            <button id="addr-save-btn" class="btn btn-primary" type="button">Save Address</button>
            <p id="addr-msg" style="display:none;margin:0;font-size:0.85rem;color:var(--tag-sage-deep);"></p>
          </div>
        </div>
      </div>

      <!-- REWARDS TAB -->
      <div id="tab-rewards" class="tab-pane" style="display:none;">
        <div class="rewards-summary">
          <div class="card reward-stat stat-points">
            <p id="r-points" class="stat-num text-gradient-gold">—</p>
            <p class="stat-label">Your Active Points</p>
          </div>
          <div class="card reward-stat stat-tier">
            <p id="r-tier" class="stat-num text-gradient">—</p>
            <p class="stat-label">Current Member Tier</p>
          </div>
          <div class="card reward-stat stat-spent">
            <p id="r-spent" class="stat-num">—</p>
            <p class="stat-label">Total Spend</p>
          </div>
        </div>

        <div class="card tier-progress-card">
          <h3>Tier Progression</h3>
          <div id="tier-progress" class="tier-progress"></div>
        </div>

        <div class="card pane-card" style="margin-top: var(--space-lg);">
          <h3>How to earn Gobble Points</h3>
          <div class="earn-list">
            {earnRules.map(([action, pts, note]) => (
              <div class="earn-row">
                <div>
                  <p class="earn-action">{action}</p>
                  <p class="earn-note">{note}</p>
                </div>
                <span class="earn-pts">{pts}</span>
              </div>
            ))}
          </div>

          <h3 style="margin-top: var(--space-lg);">Tier Benefits</h3>
          <div class="tier-list">
            {tiers.map((t) => (
              <div class="card tier-card">
                <span class="tier-chip" style={`background:${t.color}22; color:${t.color}; border: 1px solid ${t.color}44;`}>{t.name}</span>
                <div>
                  <p class="tier-range">{t.range}</p>
                  <p class="tier-perks">{t.perks}</p>
                </div>
              </div>
            ))}
          </div>

          <!-- Redeem — points → store credit (Console mints the coupon; the
              shopper applies it in the checkout credit box at the cart). -->
          <div id="redeem-slot" style="margin-top:1.2rem;border:1px solid var(--border-hairline);background:var(--bg-parchment-alt);padding:1.2rem;">
            <p style="margin:0 0 0.6rem;font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:var(--text-muted);">Redeem points for store credit</p>
            <div style="display:flex;flex-wrap:wrap;gap:0.5rem;align-items:stretch;">
              <input id="redeem-amount" type="number" min="1" step="1" placeholder="₹ of credit" class="text-field" style="width:8rem;" />
              <button id="redeem-btn" class="btn btn-outline" type="button">Redeem</button>
              <button id="redeem-all" type="button" style="background:none;border:none;cursor:pointer;font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:var(--text-muted);">Redeem all</button>
            </div>
            <div id="redeem-result" style="display:none;margin-top:0.8rem;font-size:0.85rem;color:var(--text-espresso-soft);"></div>
            <p id="redeem-error" style="display:none;margin:0.5rem 0 0;font-size:0.8rem;color:var(--accent-berry-deep);"></p>
          </div>

          <!-- Recent activity — the points ledger (last 10). -->
          <div id="loyalty-transactions" style="display:none;margin-top:1.2rem;">
            <p style="margin:0 0 0.4rem;font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:var(--text-muted);">Recent activity</p>
            <div id="loyalty-tx-list"></div>
          </div>

          <!-- Referral — nanoliss lifecycle. -->
          <div id="referral-card" style="display:none;margin-top:1.2rem;border:1px solid var(--border-hairline);padding:1.2rem;">
            <p style="margin:0 0 0.6rem;font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:var(--text-muted);">Refer a friend</p>
            <div style="display:flex;align-items:center;gap:0.8rem;flex-wrap:wrap;">
              <code data-ref-code style="font-family:var(--font-display);font-weight:700;font-size:1.2rem;color:var(--accent-gold-deep);"></code>
              <button id="ref-copy-code" type="button" class="btn btn-outline" style="padding:0.35rem 0.8rem;font-size:0.78rem;">Copy code</button>
              <button id="ref-copy-link" type="button" class="btn btn-outline" style="padding:0.35rem 0.8rem;font-size:0.78rem;">Copy invite link</button>
              <a id="ref-wa" href="#" target="_blank" rel="noopener" class="btn btn-outline" style="padding:0.35rem 0.8rem;font-size:0.78rem;">Share on WhatsApp</a>
            </div>
            <p id="ref-meta" style="margin:0.6rem 0 0;font-size:0.82rem;color:var(--text-muted);"></p>
            <p id="ref-status" style="display:none;margin:0.5rem 0 0;font-size:0.85rem;color:var(--text-espresso);"></p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <style>
    .auth-gate { padding: var(--space-2xl) 0; max-width: 520px; margin: 0 auto; text-align: center; }
    .auth-gate-card { padding: var(--space-xl); }
    .session-notice { color: var(--accent-berry-deep); font-size: 0.88rem; font-weight: 600; }
    .auth-gate-sub { color: var(--text-espresso-soft); margin-bottom: var(--space-lg); line-height: 1.5; }
    .auth-gate-ctas { display: flex; flex-direction: column; gap: var(--space-sm); }

    .acct-header { padding: var(--space-lg) 0 var(--space-md); }
    .acct-header-inner { padding: var(--space-lg); display: flex; justify-content: space-between; align-items: center; }
    .greeting-sub { color: var(--text-muted); font-size: 0.9rem; margin: 0; }
    .points-badge { text-align: right; background: rgba(255,255,255,0.7); padding: var(--space-sm) var(--space-md); border-radius: var(--radius-md); border: 1px solid var(--border-hairline); }
    .tier-badge {
      display: inline-block; font-size: 0.73rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
      padding: 0.35rem 0.85rem; border-radius: var(--radius-pill); margin-bottom: 0.3rem;
    }
    .points-display { font-family: var(--font-display); font-size: 2.2rem; font-weight: 700; line-height: 1; }
    .points-label { font-size: 0.78rem; color: var(--text-muted); font-weight: 600; }

    .tabs-bar {
      border-bottom: 1px solid var(--border-hairline); position: sticky; top: 68px;
      background: rgba(253, 251, 242, 0.95); backdrop-filter: blur(12px); z-index: 40;
    }
    .tabs-inner { display: flex; gap: var(--space-xl); }
    .tab-btn {
      background: none; border: none; padding: var(--space-sm) 0; font-family: var(--font-body);
      font-weight: 700; font-size: 0.92rem; color: var(--text-muted);
      border-bottom: 3px solid transparent; cursor: pointer; transition: all 0.2s ease;
    }
    .tab-btn.active { color: var(--accent-berry); border-bottom-color: var(--accent-berry); }

    .tab-content { padding: var(--space-lg) 0; }
    .pane-card { padding: var(--space-lg); }
    .profile-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-md); max-width: 680px; margin-top: var(--space-md); }
    .profile-actions { display: flex; align-items: center; gap: var(--space-md); grid-column: span 2; margin-top: var(--space-sm); }
    .saved-msg { color: var(--tag-sage-deep); font-size: 0.88rem; font-weight: 600; }
    .signout-row { grid-column: span 2; border-top: 1px solid var(--border-hairline); padding-top: var(--space-md); margin-top: var(--space-md); }
    .signout-link { background: none; border: none; color: var(--text-muted); font-size: 0.85rem; cursor: pointer; text-decoration: underline; }

    .rewards-summary { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-md); margin-bottom: var(--space-lg); }
    .reward-stat { text-align: center; padding: var(--space-md); }
    .stat-num { font-family: var(--font-display); font-size: 2.2rem; font-weight: 700; line-height: 1.1; margin-bottom: 0.2rem; }
    .stat-label { font-size: 0.8rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; }

    .tier-progress-card { padding: var(--space-lg); }
    .tier-progress { margin-top: var(--space-sm); }
    .progress-track { width: 100%; height: 10px; background: var(--bg-parchment-alt); border-radius: var(--radius-pill); overflow: hidden; border: 1px solid var(--border-hairline); }
    .progress-fill { height: 100%; background: linear-gradient(90deg, var(--accent-gold), var(--accent-coral), var(--accent-berry)); border-radius: var(--radius-pill); transition: width 0.6s ease; }

    .earn-list { margin-top: var(--space-sm); }
    .earn-row { display: flex; justify-content: space-between; align-items: center; padding: 0.85rem 0; border-bottom: 1px solid var(--border-hairline); }
    .earn-action { font-weight: 600; font-size: 0.95rem; }
    .earn-note { font-size: 0.82rem; color: var(--text-muted); margin: 0; }
    .earn-pts { font-family: var(--font-display); font-weight: 700; font-size: 1.1rem; color: var(--accent-gold-deep); }

    .tier-list { display: flex; flex-direction: column; gap: var(--space-sm); margin-top: var(--space-sm); }
    .tier-card { display: flex; align-items: flex-start; gap: var(--space-md); padding: var(--space-md); }
    .tier-chip { font-size: 0.74rem; font-weight: 700; padding: 0.35rem 0.8rem; border-radius: var(--radius-pill); flex-shrink: 0; text-transform: uppercase; }
    .tier-range { font-weight: 700; font-size: 0.95rem; margin-bottom: 0.2rem; }
    .tier-perks { font-size: 0.88rem; color: var(--text-espresso-soft); margin: 0; }

    @media (max-width: 720px) {
      .acct-header-inner { flex-direction: column; text-align: center; gap: var(--space-md); }
      .points-badge { width: 100%; text-align: center; }
      .profile-grid { grid-template-columns: 1fr; }
      .profile-actions, .signout-row { grid-column: span 1; }
      .rewards-summary { grid-template-columns: 1fr; }
    }
  </style>

  <script is:inline>
    // Console-native account (2026-10-07). Identity comes from the httpOnly
    // session cookie via our own /api/account/* proxies — localStorage holds
    // nothing (the Sheet era kept the Auth token in gbp_auth, readable by any
    // script on the page). The tab/profile/orders/rewards RENDERING below is
    // unchanged; only where the data comes from moved.
    (function () {
      function fmtINR(n) { return '₹' + Number(n).toLocaleString('en-IN'); }
      function fmtDate(iso) { try { return new Date(iso).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' }); } catch (e) { return iso; } }

      function showGate() {
        document.getElementById('auth-gate').style.display = 'block';
      }

      var TIER_COLORS = { Nibbler: 'var(--tag-sage)', Foodie: 'var(--accent-gold-deep)', 'Gobbler VIP': 'var(--accent-berry-deep)' };

      // Display tier is derived from points with the HOUSE thresholds, always.
      //
      // This used to be `if (storedTier) return storedTier` — prefer Console's
      // tier, fall back to house rules. That was safe only while Console sent
      // null, which it always did: nothing wrote customers.loyalty_tier. On
      // 2026-10-10 Console started returning a DERIVED tier (Bronze/Silver/
      // Gold/Platinum, computed from lifetime spend) so other storefronts
      // stopped needing a hardcoded fallback. That silently turned this branch
      // live and every Gobble customer began reading "Bronze" on a page whose
      // legend is Nibbler / Foodie / Gobbler VIP — with no TIER_COLORS entry,
      // so the badge lost its colour too.
      //
      // The original comment said the right thing and the code contradicted it:
      // the NAMES are Gobble's brand copy, not Console data. So Console's tier
      // is deliberately NOT a parameter here. Gobble owns its tier vocabulary.
      function displayTier(points) {
        if (points >= 1000) return 'Gobbler VIP';
        if (points >= 300) return 'Foodie';
        return 'Nibbler';
      }

      function fillIdentity(customer) {
        var firstName = (customer.name || '').split(' ')[0];
        var greeting = document.getElementById('acct-greeting');
        if (greeting) greeting.textContent = 'Hello, ' + firstName + '.';

        if (document.getElementById('p-name')) document.getElementById('p-name').value = customer.name || '';
        if (document.getElementById('p-email')) document.getElementById('p-email').value = customer.email || '';
        fillPhone(customer.phone);
      }

      // Split the stored E.164 number into the dial select and the national
      // number in the input.
      //
      // The save handler assembles '+' + dial + digits, so the input must
      // hold the NATIONAL number only. It used to hold the whole stored
      // number ("+919876543210"), so every profile save doubled the
      // country code: "+91" + "919876543210" = "+91919876543210".
      //
      // The dial codes come from the SELECT'S OWN OPTIONS - the same
      // generated list the server rendered - sorted LONGEST FIRST, because a
      // prefix match has to try +971 before +97. A country is only read
      // from an E.164 number (an explicit "+"): a bare number carries no
      // country code, so the whole number stays in the input and the dial
      // keeps its default rather than guessing one.
      function fillPhone(stored) {
        var phoneEl = document.getElementById('p-phone');
        var dialEl = document.getElementById('p-dial');
        if (!phoneEl) return;
        var raw = String(stored || '');
        var digits = raw.replace(/\D/g, '');
        phoneEl.value = digits;
        if (!dialEl || raw.indexOf('+') !== 0) return;
        var dials = Array.prototype.map.call(dialEl.options, function (o) { return o.value; });
        dials.sort(function (a, b) { return b.length - a.length; });
        for (var i = 0; i < dials.length; i++) {
          if (digits.indexOf(dials[i]) === 0) {
            dialEl.value = dials[i];
            phoneEl.value = digits.slice(dials[i].length);
            return;
          }
        }
      }

      function fillRewards(loyalty) {
        var pts = loyalty.points || 0;
        // Prefer Console's tier (tenant-named in Settings → Rewards, e.g.
        // Nibbler/Foodie/Gobbler VIP when the owner renames them there).
        // displayTier(points) only covers pre-rename data where Console has
        // no name yet.
        var tier = loyalty.tier || displayTier(pts);

        document.getElementById('acct-points-badge').style.display = 'block';
        var tierEl = document.getElementById('tier-badge');
        var color = TIER_COLORS[tier] || TIER_COLORS.Nibbler;
        tierEl.textContent = tier;
        tierEl.style.background = color + '22';
        tierEl.style.color = color;
        document.getElementById('points-display').textContent = pts.toLocaleString('en-IN');

        document.getElementById('r-points').textContent = pts.toLocaleString('en-IN');
        document.getElementById('r-tier').textContent = tier;
        document.getElementById('r-spent').textContent = fmtINR(loyalty.totalSpent || 0);

        var prog = document.getElementById('tier-progress');
        var spent = Number(loyalty.totalSpent || 0);
        var tiers = Array.isArray(loyalty.tiers) ? loyalty.tiers : [];
        var currentIdx = tiers.findIndex(function(t) { return t.isCurrent; });
        if (currentIdx < 0) currentIdx = 0;
        var next = tiers[currentIdx + 1] || null;

        if (next) {
          var from = Number(tiers[currentIdx].fromInr || 0);
          var to = Number(next.fromInr || from);
          var pct = Math.min(100, Math.round(((spent - from) / Math.max(1, to - from)) * 100));
          prog.innerHTML = '<p style="margin-bottom:0.6rem;font-size:0.9rem;color:var(--text-espresso-soft)">₹' + Math.max(0, to - spent).toLocaleString('en-IN') + ' more lifetime spend to reach <strong style="color:var(--text-espresso)">' + String(next.name).replace(/[<>"']/g, '') + '</strong></p>'
            + '<div class="progress-track"><div class="progress-fill" style="width:' + pct + '%"></div></div>';
        } else {
          prog.innerHTML = '<p style="color:var(--accent-berry);font-weight:600">You are at the top tier. Thank you for gobbling with us!</p>';
        }

        // Recent activity — the ledger (last 10), nanoliss parity.
        var txWrap = document.getElementById('loyalty-transactions');
        var txList = document.getElementById('loyalty-tx-list');
        if (txWrap && txList && Array.isArray(loyalty.transactions) && loyalty.transactions.length) {
          txList.innerHTML = loyalty.transactions.slice(0, 10).map(function (t) {
            var pp = Number(t.points) || 0;
            var when = t.createdAt ? new Date(t.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) : '';
            return '<div style="display:flex;justify-content:space-between;padding:0.35rem 0;border-bottom:1px solid var(--border-hairline);">' +
              '<span style="font-size:0.82rem;color:var(--text-muted);">' + String(t.type || 'activity').replace(/[<>"']/g, '') + (when ? ' · ' + when : '') + '</span>' +
              '<span style="font-size:0.82rem;color:' + (pp >= 0 ? 'var(--accent-gold-deep)' : 'var(--accent-berry-deep)') + ';">' + (pp >= 0 ? '+' : '−') + Math.abs(pp) + '</span></div>';
          }).join('');
          txWrap.style.display = 'block';
        }

        // Dynamic legend from Console tier names (tenant freedom).
        var list = document.querySelector('.tier-list');
        if (list && tiers.length) {
          var brandColors = ['var(--tag-sage)', 'var(--accent-gold-deep)', 'var(--accent-berry)', 'var(--text-espresso)'];
          list.innerHTML = tiers.map(function(t, i) {
            var nm = String(t.name || '').replace(/[<>"']/g, '');
            var fromInr = Number(t.fromInr || 0);
            var c = brandColors[i % brandColors.length];
            var range = fromInr > 0 ? ('₹' + fromInr.toLocaleString('en-IN') + '+ lifetime spend') : 'From your first order';
            return '<div class="card tier-card"><span class="tier-chip" style="background:' + c + '22; color:' + c + '; border: 1px solid ' + c + '44;">' + nm + (t.isCurrent ? ' ✓' : '') + '</span><div><p class="tier-range">' + range + '</p><p class="tier-perks">' + (t.isCurrent ? 'Your current tier' : 'Lifetime-spend tier · points accrue on every order') + '</p></div></div>';
          }).join('');
        }

        // Earn rules dynamic copy.
        var earnList = document.querySelector('.earn-list');
        if (earnList && typeof loyalty.earnRate === 'number') {
          var earnEls = earnList.querySelectorAll('.earn-row');
          var second = earnEls[1];
          if (second) {
            var ptsEl2 = second.querySelector('.earn-pts');
            var noteEl2 = second.querySelector('.earn-note');
            if (ptsEl2) ptsEl2.textContent = loyalty.earnRate + ' pts per ₹100';
            if (noteEl2) noteEl2.textContent = 'Over ₹' + (loyalty.minOrder || 300) + ', automatic on payment';
          }
        }
      }

      // Identity probe: 200 fills the page, 401 shows the gate. No token in
      // JS to check anymore — the cookie is httpOnly by design.
      fetch('/api/account/profile')
        .then(function (r) {
          if (r.status === 401) { showGate(); return null; }
          return r.json();
        })
        .then(function (data) {
          if (!data || !data.customer) return;
          document.getElementById('acct-content-wrap').style.display = 'block';
          fillIdentity(data.customer);
          return fetch('/api/account/loyalty')
            .then(function (r) { return r.json(); })
            .then(function (loyal) { fillRewards(loyal); })
            .catch(function () { fillRewards({ points: 0, tier: null, totalSpent: 0 }); });
        })
        .catch(function () { showGate(); });

      var tabs = document.querySelectorAll('.tab-btn');
      function activateTab(name) {
        tabs.forEach(function (t) { t.classList.toggle('active', t.getAttribute('data-tab') === name); });
        document.querySelectorAll('.tab-pane').forEach(function (c) { c.style.display = 'none'; });
        var el = document.getElementById('tab-' + name);
        if (el) el.style.display = 'block';
        if (name === 'orders') renderOrders();
        if (name === 'addresses') loadAddresses();
      }
      tabs.forEach(function (t) { t.addEventListener('click', function () { activateTab(this.getAttribute('data-tab')); }); });
      activateTab('profile');

      document.getElementById('save-profile-btn')?.addEventListener('click', function () {
        var name = document.getElementById('p-name')?.value.trim();
        var phone = document.getElementById('p-phone')?.value.trim();
        var msg = document.getElementById('profile-saved-msg');

        var dial = document.getElementById('p-dial')?.value || '91';
        if (phone) { var dg = phone.replace(/\D/g, '').replace(/^0+/, ''); if (dg) phone = '+' + dial + dg; }
        fetch('/api/account/profile', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name: name, phone: phone, birthday: document.getElementById('p-birthday')?.value || undefined, marketingConsent: document.getElementById('p-consent')?.checked === true }),
        })
          .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
          .then(function (out) {
            msg.textContent = out.ok ? 'Saved ✓ — your details are up to date.' : (out.d.error || 'Could not save — please try again.');
            msg.style.display = 'inline';
            if (out.ok) setTimeout(function () { msg.style.display = 'none'; }, 4000);
          })
          .catch(function () { msg.textContent = 'Could not reach the store — check your connection.'; msg.style.display = 'inline'; });
      });

      // ── Redeem points → store credit ──
      async function redeem(all) {
        var amountEl = document.getElementById('redeem-amount');
        var result = document.getElementById('redeem-result');
        var error = document.getElementById('redeem-error');
        result.style.display = 'none'; error.style.display = 'none';
        try {
          var res = await fetch('/api/account/loyalty/redeem', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(all ? {} : { amount: amountEl ? amountEl.value : '' }),
          });
          var data = await res.json().catch(function(){ return {}; });
          if (!res.ok) throw new Error(data.error || 'Could not redeem right now.');
          if (amountEl) amountEl.value = '';
          result.innerHTML = 'Store credit <strong style="color:var(--text-espresso)">₹' + Number(data.amount).toLocaleString('en-IN') + '</strong> is ready — your code: <code style="background:var(--bg-parchment-alt);padding:0.15rem 0.5rem;">' + String(data.code || '').replace(/[<>"']/g, '') + '</code> · ' + Number(data.remainingPoints || 0).toLocaleString('en-IN') + ' points left. Paste it in the credit box at checkout.';
          result.style.display = 'block';
          var pe = document.getElementById('points-display'); if (pe) pe.textContent = Number(data.remainingPoints || 0).toLocaleString('en-IN');
          var re = document.getElementById('r-points'); if (re) re.textContent = Number(data.remainingPoints || 0).toLocaleString('en-IN');
        } catch (err) {
          error.textContent = err instanceof Error ? err.message : 'Could not redeem right now.';
          error.style.display = 'block';
        }
      }
      document.getElementById('redeem-btn')?.addEventListener('click', function(){ redeem(false); });
      document.getElementById('redeem-all')?.addEventListener('click', function(){ redeem(true); });

      // ── Referral: stats + share + redemption loop (nanoliss lifecycle) ──
      fetch('/api/account/referral').then(function(r){ return r.ok ? r.json() : null; }).then(function(j) {
        if (!j || !j.referralCode) return;
        var card = document.getElementById('referral-card');
        if (card) card.style.display = 'block';
        var codeEl = document.querySelector('[data-ref-code]'); if (codeEl) codeEl.textContent = j.referralCode;
        var link = j.shareUrl || (location.origin + '/r/' + j.referralCode);
        var meta = document.getElementById('ref-meta');
        if (meta) meta.textContent = (j.referredCount || 0) + ' friends joined · ₹' + Number(j.rewardsEarned || 0).toLocaleString('en-IN') + ' earned';
        var wa = document.getElementById('ref-wa');
        if (wa) wa.href = 'https://wa.me/?text=' + encodeURIComponent('You’re invited to Gobble by Pixie — create your account with my code ' + j.referralCode + ': ' + link);
        document.getElementById('ref-copy-code')?.addEventListener('click', function(){ if (navigator.clipboard) navigator.clipboard.writeText(j.referralCode).catch(function(){}); });
        document.getElementById('ref-copy-link')?.addEventListener('click', function(){ if (navigator.clipboard) navigator.clipboard.writeText(link).catch(function(){}); });
      }).catch(function(){});
      try {
        var refPending = new URLSearchParams(window.location.search).get('refPending');
        if (refPending && refPending.trim()) localStorage.setItem('gbp:referralCode', refPending.trim().toUpperCase());
        var pendingCode = localStorage.getItem('gbp:referralCode');
        if (pendingCode) {
          fetch('/api/account/referral-redeem', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ code: pendingCode }),
          }).then(function(r){ return r.json().then(function(d){ return { ok: r.ok, d: d }; }); }).then(function(out) {
            if (out.ok && (out.d.success || out.d.redemptionId)) {
              localStorage.removeItem('gbp:referralCode');
              var st = document.getElementById('ref-status');
              if (st) { st.textContent = 'Invitation applied — your reward lands with your next order.'; st.style.display = 'block'; }
            }
          }).catch(function(){});
        }
      } catch (e) {}

      // ── Password: email reset link (hasPassword-aware copy) ──
      var pwdWrap = document.getElementById('password-section');
      if (pwdWrap) {
        var pd = document.getElementById('password-desc');
        if (pd) pd.textContent = pwdWrap.dataset.hasPassword === 'true'
          ? 'Want a new password? Send a reset link to your email to change it.'
          : 'Add a password so you can also log in with your email.';
      }
      document.getElementById('pwd-btn')?.addEventListener('click', function() {
        var msg = document.getElementById('pwd-msg');
        var email = document.getElementById('p-email')?.value.trim();
        if (!email) { if (msg) { msg.textContent = 'No email on file.'; msg.style.display = 'block'; } return; }
        fetch('/api/auth/forgot-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: email }),
        }).then(function(r){ return r.json().then(function(d){ return { ok: r.ok, d: d }; }); }).then(function(out) {
          var msg = document.getElementById('pwd-msg');
          if (msg) { msg.textContent = out.ok ? 'Reset link sent to ' + email + ' — check your inbox.' : (out.d.error || 'Could not send.'); msg.style.display = 'block'; }
        }).catch(function(){});
      });

      document.getElementById('signout-btn')?.addEventListener('click', function () {
        fetch('/api/auth/logout', { method: 'POST' })
          .catch(function () {})
          .finally(function () { window.location.href = '/login'; });
      });

      // ── Shipping addresses — Console is the store ──
      function renderAddresses(list) {
        var listEl = document.getElementById('addr-list');
        if (!listEl) return;
        if (!list || list.length === 0) {
          listEl.innerHTML = '<p style="margin:0;font-size:0.88rem;color:var(--text-muted);">No saved addresses yet.</p>';
          return;
        }
        listEl.innerHTML = list.map(function (a) {
          var isDefault = a.isDefault;
          return '<div style="display:flex;justify-content:space-between;gap:1rem;padding:0.8rem;border:1px solid var(--border-hairline);background:var(--bg-parchment-alt);' + (isDefault ? 'border-color:var(--accent-gold);' : '') + '">'
            + '<div style="min-width:0;">'
            + (isDefault ? '<p style="margin:0 0 0.2rem;font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:var(--accent-gold-deep);">Default</p>' : '')
            + '<p style="margin:0;font-size:0.85rem;color:var(--text-espresso-soft);">'
            + escHtml([a.line1, a.line2, a.city, a.state, a.pincode, a.country].filter(Boolean).join(', '))
            + '</p></div>'
            + '<div style="display:flex;flex-direction:column;gap:0.3rem;flex-shrink:0;">'
            + (!isDefault ? '<button type="button" onclick="setDefaultAddress(\'' + a.id + '\')" style="background:none;border:none;cursor:pointer;font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:var(--text-muted);">Set Default</button>' : '')
            + '<button type="button" onclick="deleteAddress(\'' + a.id + '\')" style="background:none;border:none;cursor:pointer;font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:var(--accent-berry-deep);">Remove</button>'
            + '</div></div>';
        }).join('');
      }

      function loadAddresses() {
        fetch('/api/account/addresses', { cache: 'no-store' })
          .then(function (r) { return r.json(); })
          .then(function (data) { renderAddresses(data.addresses || []); })
          .catch(function () {});
      }
      window.loadAddresses = loadAddresses;
      loadAddresses();

      window.setDefaultAddress = function (id) {
        fetch('/api/account/addresses/' + id, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ isDefault: true }),
        }).then(function () { loadAddresses(); }).catch(function () {});
      };
      window.deleteAddress = function (id) {
        fetch('/api/account/addresses/' + id, { method: 'DELETE' })
          .then(function () { loadAddresses(); }).catch(function () {});
      };

      document.getElementById('addr-save-btn')?.addEventListener('click', function () {
        var msg = document.getElementById('addr-msg');
        var line1 = document.getElementById('a-line1')?.value.trim();
        if (!line1) { if (msg) { msg.textContent = 'Address line 1 is required.'; msg.style.display = 'inline'; } return; }
        fetch('/api/account/addresses', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            line1: line1,
            line2: document.getElementById('a-line2')?.value.trim() || undefined,
            city: document.getElementById('a-city')?.value.trim(),
            state: document.getElementById('a-state')?.value.trim(),
            pincode: document.getElementById('a-pincode')?.value.trim(),
            country: document.getElementById('a-country')?.value || 'India',
            isDefault: false,
          }),
        })
          .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
          .then(function (out) {
            if (msg) { msg.textContent = out.ok ? '✓ Address saved.' : (out.d.error || 'Could not save — please try again.'); msg.style.display = 'inline'; }
            if (out.ok) {
              ['a-line1', 'a-line2', 'a-city', 'a-state', 'a-pincode'].forEach(function (id) { var el = document.getElementById(id); if (el) el.value = ''; });
              loadAddresses();
            }
          })
          .catch(function () { if (msg) { msg.textContent = 'Could not reach the store — check your connection.'; msg.style.display = 'inline'; } });
      });

      // India-only PIN autofill (same public API as TCS/Nanoliss checkout).
      var pincodeInput = document.getElementById('a-pincode');
      var pincodeStatus = document.getElementById('a-pincode-status');
      var cityInput = document.getElementById('a-city');
      var stateInput = document.getElementById('a-state');
      var countrySelect = document.getElementById('a-country');
      var lookupController = null;
      if (pincodeInput) {
        pincodeInput.addEventListener('input', function () {
          if (countrySelect && countrySelect.value !== 'India') return;
          var pin = pincodeInput.value.trim();
          if (!/^\d{6}$/.test(pin)) { if (pincodeStatus) pincodeStatus.style.display = 'none'; return; }
          if (lookupController) lookupController.abort();
          var controller = new AbortController();
          lookupController = controller;
          if (pincodeStatus) { pincodeStatus.textContent = 'Looking up city & state…'; pincodeStatus.style.display = 'block'; }
          fetch('https://api.postalpincode.in/pincode/' + pin, { signal: controller.signal })
            .then(function (r) { return r.json(); })
            .then(function (data) {
              var po = data && data[0] && data[0].PostOffice && data[0].PostOffice[0];
              if (data && data[0] && data[0].Status === 'Success' && po) {
                if (cityInput) cityInput.value = po.District || po.Name || cityInput.value;
                if (stateInput) stateInput.value = po.State || stateInput.value;
                if (pincodeStatus) pincodeStatus.textContent = po.District + ', ' + po.State;
              } else if (pincodeStatus) {
                pincodeStatus.textContent = 'Could not find that PIN — type city & state manually.';
              }
            })
            .catch(function () { if (pincodeStatus) pincodeStatus.style.display = 'none'; });
        });
      }

      var base = (typeof window !== "undefined" && window.GOBBLE_WHATSAPP_HREF) || null;
      function waOpen(text) { if (!base) return; window.open(base + '?text=' + encodeURIComponent(text), '_blank', 'noopener'); }

      function reorderText(o) {
        return 'Hi! I\'d like to reorder: ' + (orderTitle(o) || 'my previous order')
          + (o.orderNumber ? (' (Order ref: ' + o.orderNumber + ')') : '')
          + '. Same as before, please!';
      }

      // Console order shape: { id, orderNumber, date, status, paymentStatus,
      // total, items: [{ productName, qty, unitPrice }] }. The Sheet-era fields
      // (productName/amountPaid/orderId at top level) are mapped here, not in
      // the proxy, so the proxy stays a dumb forwarder.
      function orderTitle(o) {
        if (!o.items || !o.items.length) return 'Order';
        var first = o.items[0].productName || 'Order';
        return o.items.length > 1 ? first + ' (+' + (o.items.length - 1) + ' more)' : first;
      }

      function escHtml(s) {
        return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
      }

      // Collapsed-by-default order accordion (owner 2026-11-05, estate-wide:
      // "orders in expanded state / details not proper" — the summary is the
      // receipt header; the body carries items, the price ladder, delivery
      // address, shipped/delivered dates and the invoice link). Console
      // enriches items with `image` and orders with `shippingAddress`,
      // `shippedAt`, `deliveredAt`; older rows simply omit them.
      function renderOrderList(orders) {
        var el = document.getElementById('orders-list');
        if (!orders.length) {
          el.innerHTML = '<div class="card" style="text-align:center;padding:3rem 1rem;"><p style="font-family:var(--font-display);font-size:1.4rem;color:var(--text-espresso);">No order history found yet.</p><p style="color:var(--text-muted);font-size:0.9rem;">Your past handcrafted platter orders will appear here.</p><a href="/menu" class="btn btn-primary" style="margin-top:1rem;display:inline-flex;">Browse Menu</a></div>';
          return;
        }
        var chevron = '<svg class="order-chev" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>';
        el.innerHTML = orders.map(function (o) {
          var reorderHref = base ? base + '?text=' + encodeURIComponent(reorderText(o)) : null;
          var statusBadge = o.status && o.status !== 'Confirmed'
            ? '<span style="font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.04em;color:var(--accent-berry-deep);background:rgba(161,95,96,0.12);padding:0.2rem 0.55rem;border-radius:2px;margin-left:0.5rem;">' + escHtml(o.status) + '</span>'
            : '';
          var items = Array.isArray(o.items) ? o.items : [];
          var itemsSum = items.reduce(function (s, i) { return s + (Number(i.unitPrice) || 0) * (Number(i.qty) || 0); }, 0);
          var itemRows = items.map(function (i) {
            var thumb = i.image
              ? '<img src="' + escHtml(i.image) + '" alt="" width="56" height="70" loading="lazy" style="height:70px;width:56px;flex:none;object-fit:cover;background:var(--bg-parchment-alt);" />'
              : '<span style="height:70px;width:56px;flex:none;display:inline-block;background:var(--bg-parchment-alt);"></span>';
            return '<div style="display:flex;align-items:center;gap:0.9rem;padding:0.6rem 0;">'
              + thumb
              + '<div style="flex:1;min-width:0;">'
              + '<p style="margin:0;font-weight:600;font-size:0.92rem;color:var(--text-espresso);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">' + escHtml(i.productName) + '</p>'
              + '<p style="margin:0;font-size:0.8rem;color:var(--text-muted);">' + fmtINR(i.unitPrice) + ' &middot; &times; ' + escHtml(i.qty) + '</p>'
              + '</div>'
              + '<p style="margin:0;font-size:0.9rem;color:var(--text-espresso-soft);">' + fmtINR((Number(i.unitPrice) || 0) * (Number(i.qty) || 0)) + '</p>'
              + '</div>';
          }).join('');
          var ladder = ''
            + (items.length ? '<div style="display:flex;justify-content:space-between;font-size:0.82rem;color:var(--text-muted);"><span>Items</span><span>' + fmtINR(itemsSum) + '</span></div>' : '')
            + ((Number(o.discount) || 0) > 0 ? '<div style="display:flex;justify-content:space-between;font-size:0.82rem;color:var(--accent-berry-deep);"><span>Coupon' + (o.couponCode ? ': ' + escHtml(o.couponCode) : '') + '</span><span>&minus;' + fmtINR(o.discount) + '</span></div>' : '')
            + ((Number(o.shippingFee) || 0) > 0 ? '<div style="display:flex;justify-content:space-between;font-size:0.82rem;color:var(--text-muted);"><span>Shipping</span><span>' + fmtINR(o.shippingFee) + '</span></div>' : '');
          var addr = o.shippingAddress
            ? '<div style="margin-top:0.8rem;padding-top:0.8rem;border-top:1px solid var(--border-hairline);">'
              + '<p style="margin:0 0 0.25rem;font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:var(--text-muted);">Delivery address</p>'
              + '<p style="margin:0;font-size:0.85rem;color:var(--text-espresso-soft);">' + escHtml([o.shippingAddress.line1, o.shippingAddress.city, o.shippingAddress.state, o.shippingAddress.pincode].filter(Boolean).join(', ')) + '</p>'
              + '</div>'
            : '';
          var payLabel = o.paymentMethod === 'cod' ? 'Cash on Delivery' : (o.paymentMethod === 'manual' ? 'Direct Payment' : 'Prepaid');
      var timeline = ''
            + (o.paymentMethod ? '<p style="margin:0.35rem 0 0;font-size:0.8rem;color:var(--text-muted);">' + payLabel + '</p>' : '')
            + (o.shippedAt ? '<p style="margin:0.35rem 0 0;font-size:0.8rem;color:var(--text-muted);">Shipped ' + fmtDate(o.shippedAt) + '</p>' : '')
            + (o.deliveredAt ? '<p style="margin:0.35rem 0 0;font-size:0.8rem;color:var(--text-muted);">Delivered ' + fmtDate(o.deliveredAt) + '</p>' : '');
          // Delivery partner block (Console DELIVERY.md §8.6): the named
          // courier + AWB + live tracking lead, so a customer with a late
          // parcel calls the COURIER, not the store. Fields flow straight
          // from Console's customers/orders; absent until booked or
          // manually dispatched — untracked orders render exactly as before.
          var tracking = (o.courier || o.trackingNumber)
            ? '<div style="margin-top:0.8rem;padding-top:0.8rem;border-top:1px solid var(--border-hairline);">'
              + '<p style="margin:0 0 0.25rem;font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:var(--text-muted);">Delivery</p>'
              + '<p style="margin:0;font-size:0.85rem;color:var(--text-espresso-soft);">'
              + (o.courier ? 'Delivered by <strong style="font-weight:600;color:var(--text-espresso);">' + escHtml(o.courier) + '</strong>' : '')
              + (o.courier && o.trackingNumber ? ' &middot; ' : '')
              + (o.trackingNumber ? 'AWB ' + escHtml(o.trackingNumber) : '')
              + (o.trackUrl ? ' <a href="' + escHtml(o.trackUrl) + '" target="_blank" rel="noopener noreferrer" style="color:var(--accent-berry-deep);text-decoration:underline;text-underline-offset:3px;">Track live</a>' : '')
              + '</p>'
              + '<p style="margin:0.25rem 0 0;font-size:0.78rem;color:var(--text-muted);">Delivery delay? The courier can see exactly where the parcel is — they&rsquo;re fastest. For anything about the order, message us.</p>'
            + '</div>'
            : '';
          var invoice = o.shareToken
            ? '<a href="/api/orders/' + encodeURIComponent(o.shareToken) + '/invoice" target="_blank" rel="noopener" class="btn btn-outline" style="padding:0.5rem 1rem;font-size:0.82rem;white-space:nowrap;">Download invoice</a>'
            : '';
          return '<details class="card order-card" style="margin-bottom:0.8rem;">'
            + '<summary style="display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap;padding:1.2rem;cursor:pointer;list-style:none;">'
            + '<div><p style="font-weight:600;margin:0;">' + fmtDate(o.date) + statusBadge + '</p>'
            + '<p style="font-size:0.85rem;color:var(--text-muted);margin:0;">' + escHtml(o.orderNumber || '') + '</p></div>'
            + '<div style="display:flex;align-items:center;gap:0.8rem;">'
            + '<p style="font-family:var(--font-display);font-weight:700;font-size:1.2rem;margin:0;color:var(--accent-gold-deep);">' + fmtINR(o.total) + '</p>'
            + chevron
            + '</div></summary>'
            + '<div style="padding:0 1.2rem 1.2rem;border-top:1px solid var(--border-hairline);">'
            + '<div style="padding-top:0.6rem;">' + itemRows + '</div>'
            + '<div style="margin-top:0.5rem;padding-top:0.8rem;border-top:1px solid var(--border-hairline);display:flex;flex-direction:column;gap:0.3rem;">' + ladder
            + '<div style="display:flex;justify-content:space-between;align-items:baseline;margin-top:0.4rem;padding-top:0.6rem;border-top:1px solid var(--border-hairline);"><span style="font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:var(--text-muted);">Order total</span><span style="font-family:var(--font-display);font-weight:700;font-size:1.15rem;color:var(--accent-gold-deep);">' + fmtINR(o.total) + '</span></div>'
            + '</div>'
            + addr + timeline + tracking
            + '<div style="margin-top:1rem;display:flex;gap:0.8rem;flex-wrap:wrap;">'
            + (reorderHref ? '<a href="' + reorderHref + '" target="_blank" rel="noopener" class="btn btn-primary" style="padding:0.5rem 1rem;font-size:0.82rem;white-space:nowrap;">Reorder</a>' : '')
            + invoice
            + '</div>'
            + '</div></details>';
        }).join('');
      }

      function renderOrders() {
        var el = document.getElementById('orders-list');
        el.innerHTML = '<p style="text-align:center;padding:2rem 0;opacity:.5;">Loading your orders…</p>';
        fetch('/api/account/orders')
          .then(function (r) { return r.json(); })
          .then(function (data) { renderOrderList(data.orders || []); })
          .catch(function () { renderOrderList([]); });
      }
    })();
  </script>
</BaseLayout>

