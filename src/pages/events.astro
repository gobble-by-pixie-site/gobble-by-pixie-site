---
import BaseLayout from '../layouts/BaseLayout.astro';
import { fetchEvents } from '../lib/fetchEvents.js';

const events = await fetchEvents();
const WA = 'https://wa.link/sngzs9';

function formatEventDate(dateStr) {
  const d = new Date(dateStr);
  if (isNaN(d.getTime())) return dateStr; // free-text fallback, e.g. "Diwali 2026"
  return d.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
}
---
<BaseLayout title="Events — Gobble by Pixie">
  <section class="events-hero">
    <div class="container">
      <p class="eyebrow">On the Table</p>
      <h1>Events & Grazing Tables</h1>
      <p class="section-sub">A look at the grazing tables, pop-ups, and celebrations we've catered — and what we're building next.</p>
    </div>
  </section>

  <section class="events-body">
    <div class="container">
      {events.length === 0 ? (
        <div class="card events-empty">
          <span class="events-empty-emoji">🧀</span>
          <h3>No events posted yet</h3>
          <p>Check back soon, or ask us on WhatsApp about booking a grazing table for your own event.</p>
          <a href={`${WA}?text=${encodeURIComponent("Hi! I'd like to ask about booking a Grazing Table for an event.")}`} target="_blank" rel="noopener" class="btn btn-primary">Enquire on WhatsApp</a>
        </div>
      ) : (
        <div class="events-grid">
          {events.map((event) => (
            <article class="card event-card">
              <div class="event-image-wrap">
                {event.image ? (
                  <div class="event-image" style={`background-image: url(${event.image})`}></div>
                ) : (
                  <div class="event-image-placeholder">
                    <span>🧀</span>
                  </div>
                )}
              </div>
              <div class="event-body">
                {event.date && <p class="event-date">{formatEventDate(event.date)}</p>}
                <h3 class="event-title">{event.title}</h3>
                {event.description && <p class="event-desc">{event.description}</p>}
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>

  <section class="events-cta">
    <div class="container">
      <p class="eyebrow">Planning Something?</p>
      <h2>Book a Grazing Table for Your Event</h2>
      <p class="section-sub">Weddings, corporate parties, milestone celebrations — every table is custom-built around your guest count, theme, and budget.</p>
      <a href={`${WA}?text=${encodeURIComponent("Hi! I'd like to enquire about a Grazing Table for a party. Could you share more details?")}`} target="_blank" rel="noopener" class="btn btn-primary">Enquire on WhatsApp</a>
    </div>
  </section>

  <style>
    .events-hero { text-align: center; padding-bottom: var(--space-md); }
    .section-sub { max-width: 52ch; margin: 0 auto; color: var(--text-espresso-soft); font-size: 1.05rem; }

    .events-empty {
      max-width: 480px; margin: 0 auto; padding: var(--space-xl); text-align: center;
    }
    .events-empty-emoji { font-size: 2.6rem; opacity: 0.5; display: block; margin-bottom: var(--space-sm); }
    .events-empty h3 { font-family: var(--font-display); margin-bottom: 0.4rem; }
    .events-empty p { color: var(--text-espresso-soft); margin-bottom: var(--space-md); }

    .events-grid {
      display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: var(--space-lg);
    }
    .event-card { overflow: hidden; display: flex; flex-direction: column; }
    .event-image-wrap { height: 220px; overflow: hidden; border-bottom: 1px solid var(--border-hairline); background: var(--bg-parchment-alt); }
    .event-image { width: 100%; height: 100%; background-size: cover; background-position: center; }
    .event-image-placeholder {
      width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;
      font-size: 2.6rem; opacity: 0.35;
      background: linear-gradient(150deg, var(--accent-gold-light), var(--bg-parchment-alt));
    }
    .event-body { padding: var(--space-md); }
    .event-date { font-size: 0.78rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--accent-gold-deep); margin: 0 0 0.3rem; }
    .event-title { font-family: var(--font-display); font-size: 1.25rem; margin: 0 0 0.4rem; }
    .event-desc { font-size: 0.92rem; color: var(--text-espresso-soft); line-height: 1.55; margin: 0; }

    .events-cta { text-align: center; background: var(--bg-parchment-alt); border-top: 1px solid var(--border-hairline); }
    .events-cta h2 { margin: 0.5rem 0; }
    .events-cta .btn { margin-top: var(--space-md); }

    @media (max-width: 720px) {
      .events-grid { grid-template-columns: 1fr; }
    }
  </style>
</BaseLayout>
