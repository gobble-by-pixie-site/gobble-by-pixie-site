---
// /products/[slug] — minimal product page for Console live-vision iframe.
// Gobble's real UX uses category pages + quick-view modals; this page
// exists solely so the Console product editor can iframe a real storefront
// page and stream live edits via postMessage.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fetchProductBySlug, formatPrice } from '../../lib/fetchProducts.js';
import { getStoreConfig } from '../../lib/store-config.js';
import { PHONE_COUNTRIES } from '../../lib/phone-countries.js';

const { slug } = Astro.params;
const product = slug ? await fetchProductBySlug(slug) : null;
const { whatsappHref } = await getStoreConfig();

if (!product) {
  return new Response(null, { status: 404 });
}

const SITE = 'https://gobblebypixie.com';
---

<BaseLayout title={`${product.name} — Gobble by Pixie`}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Product",
      name: product.name,
      description: product.description || `${product.name} — handmade flavoured cream cheese by Gobble by Pixie.`,
      image: product.image_url ? [product.image_url] : undefined,
      category: product.category,
      brand: { "@type": "Brand", name: "Gobble by Pixie" },
      offers: {
        "@type": "Offer",
        url: `${SITE}/products/${product.id}/`,
        priceCurrency: "INR",
        price: String(product.price),
        availability: product.in_stock
          ? "https://schema.org/InStock"
          : "https://schema.org/OutOfStock",
      },
    })} />
  </Fragment>
  <section class="product-page">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <a href={`/menu/${product.category.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>{product.category}</a>
        <span>/</span>
        <span class="current">{product.name}</span>
      </nav>

      <div class="product-detail">
        <div class="product-images">
          {product.images.length > 0 ? (
            product.images.map((img: string) => (
              <img src={img} alt={product.name} class="product-img" />
            ))
          ) : product.image_url ? (
            <img src={product.image_url} alt={product.name} class="product-img" />
          ) : (
            <div class="product-img placeholder">No image</div>
          )}
        </div>

        <div class="product-info">
          <p class="eyebrow">{product.category}</p>
          <h1 data-lp="name" data-lp-slug={product.slug}>{product.name}</h1>

          <p class="price" data-lp="price" data-lp-slug={product.slug}>
            {formatPrice(product.price)}
          </p>

          {product.net_weight && (
            <p class="meta">{product.net_weight}</p>
          )}

          {product.description && (
            <p class="description" data-lp="description" data-lp-slug={product.slug}>
              {product.description}
            </p>
          )}

          {product.badge && (
            <span class="badge">{product.badge}</span>
          )}

          <p class={`stock ${product.in_stock ? 'in-stock' : 'out-of-stock'}`}>
            {product.in_stock ? 'In Stock' : 'Sold Out'}
          </p>

          {/* Out of stock: let the shopper ask to be told when it returns.
              An email OR a phone (owner ask 2026-11-10) - the email is the
              universal channel, the phone is served over WhatsApp where the
              store can send one. Console dedupes per contact + product. */}
          {!product.in_stock && (
            <div class="notify-form" data-product-id={product.id}>
              <p class="notify-label">Tell me when it's back</p>
              <div class="notify-row">
                <input id="nf-email" type="email" class="text-field" placeholder="Email (optional)" aria-label="Email for restock alert" />
                <span class="notify-phone">
                  <select id="nf-dial" class="text-field" aria-label="Phone country">
                    {PHONE_COUNTRIES.map((c) => (
                      <option value={c.dial} selected={c.dial === '91'}>{c.flag} {c.shortName} +{c.dial}</option>
                    ))}
                  </select>
                  <input id="nf-phone" type="tel" inputmode="tel" class="text-field" placeholder="Phone (optional)" aria-label="Phone number for restock alert" />
                </span>
              </div>
              <button id="nf-submit" class="btn btn-primary">Notify me</button>
              <p id="nf-msg" class="notify-msg" style="display:none;"></p>
            </div>
          )}

          {whatsappHref && (
          <a href={whatsappHref} class="btn btn-primary" target="_blank" rel="noopener">
            Order on WhatsApp
          </a>
          )}
        </div>
      </div>
    </div>
  </section>

  <style>
    .product-page { padding: 6rem 0 4rem; }
    .container { max-width: 960px; margin: 0 auto; padding: 0 1.5rem; }
    .breadcrumb { font-size: 0.85rem; color: var(--text-espresso-soft); margin-bottom: 2rem; }
    .breadcrumb a { color: var(--gold); text-decoration: none; }
    .breadcrumb .current { color: var(--text-espresso); }
    .product-detail { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: start; }
    @media (max-width: 768px) { .product-detail { grid-template-columns: 1fr; } }
    .product-images { display: flex; flex-direction: column; gap: 1rem; }
    .product-img { width: 100%; border-radius: 8px; object-fit: cover; }
    .product-img.placeholder { aspect-ratio: 1; background: var(--bg-cream); display: flex; align-items: center; justify-content: center; color: var(--text-espresso-soft); }
    .product-info { display: flex; flex-direction: column; gap: 0.75rem; }
    .eyebrow { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.15em; color: var(--gold); }
    h1 { font-family: var(--font-display); font-size: 2rem; color: var(--text-espresso); margin: 0; }
    .price { font-size: 1.5rem; font-weight: 600; color: var(--text-espresso); }
    .meta { font-size: 0.9rem; color: var(--text-espresso-soft); }
    .description { font-size: 1rem; line-height: 1.7; color: var(--text-espresso-soft); }
    .badge { display: inline-block; background: var(--gold); color: #fff; padding: 0.25rem 0.75rem; border-radius: 4px; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.1em; width: fit-content; }
    .stock { font-size: 0.85rem; font-weight: 600; }
    .in-stock { color: #16a34a; }
    .out-of-stock { color: #dc2626; }
    .btn { display: inline-block; text-align: center; padding: 0.85rem 2rem; border-radius: 6px; font-weight: 600; text-decoration: none; font-size: 0.95rem; margin-top: 0.5rem; }
    .btn-primary { background: #25d366; color: #fff; }
    .notify-form { display: flex; flex-direction: column; gap: 0.5rem; }
    .notify-label { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.15em; color: var(--gold); }
    .notify-row { display: flex; gap: 0.5rem; flex-wrap: wrap; }
    .notify-row > input[type="email"] { flex: 1 1 12rem; min-width: 0; }
    .notify-phone { display: flex; gap: 0.5rem; flex: 1 1 14rem; min-width: 0; }
    .notify-phone select { flex: 0 0 auto; width: 9.5rem; min-width: 0; }
    .notify-phone input { flex: 1; min-width: 0; }
    .notify-msg { font-size: 0.85rem; }
  </style>

  <script>
    (function () {
      var params = new URLSearchParams(location.search);
      if (params.get("livedraft") !== "1") return;
      var slug = params.get("slug") || "";
      window.addEventListener("message", function (e) {
        var d = e.data || {};
        if (d.type !== "lc-product-preview" || !d.patch || !d.slug) return;
        document.querySelectorAll("[data-lp]").forEach(function (el) {
          var lpEl = el;
          if (el.getAttribute("data-lp-slug") && d.slug && el.getAttribute("data-lp-slug") !== d.slug) return;
          var k = el.getAttribute("data-lp");
          var v = d.patch[k];
          if (v === undefined || v === null) return;
          if (k === "image") {
            if (el.tagName === "IMG") lpEl.src = v;
            else lpEl.style.backgroundImage = "url('" + v + "')";
            return;
          }
          lpEl.textContent = el.getAttribute("data-lp-fmt") === "inr" ? "\u20B9" + Number(v).toLocaleString("en-IN") : String(v);
        });
      });
      parent.postMessage({ type: "lc-preview-ready", slug: slug }, "*");
    })();
  </script>

  {/* The restock ask (owner ask 2026-11-10): an email OR a phone. The
      phone is assembled from the country select + the national number, and
      a value that ALREADY starts with "+" is a full E.164 number - use it
      as it is, or the country code gets doubled. Same rule as the Console's
      own customer forms and the account page. */}
  <script>
    (function () {
      var form = document.querySelector(".notify-form");
      if (!form) return;
      var msg = document.getElementById("nf-msg");
      var btn = document.getElementById("nf-submit");
      var productId = form.getAttribute("data-product-id");
      form.addEventListener("click", async function (e) {
        var t = e.target;
        if (!t || t.id !== "nf-submit") return;
        var email = (document.getElementById("nf-email")?.value || "").trim();
        var rawPhone = (document.getElementById("nf-phone")?.value || "").trim();
        var phone = "";
        if (rawPhone.charAt(0) === "+") {
          phone = rawPhone.replace(/\s+/g, "");
        } else {
          var dial = (document.getElementById("nf-dial")?.value || "91").replace(/^\+/, "");
          var dg = rawPhone.replace(/\D/g, "").replace(/^0+/, "");
          phone = dg ? "+" + dial + dg : "";
        }
        if (!email && !phone) {
          if (msg) { msg.textContent = "Add an email or a phone number so we can reach you."; msg.style.display = "block"; msg.style.color = "var(--text-clay, #a33)"; }
          return;
        }
        if (btn) { btn.disabled = true; btn.textContent = "Saving..."; }
        try {
          var res = await fetch("/api/stock-alert", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ email: email, phone: phone, productId: productId }),
          });
          var data = await res.json().catch(function () { return {}; });
          if (!res.ok) throw new Error(data.error || "Could not save your request.");
          if (msg) {
            msg.textContent = phone
              ? "You're on the list - we'll email and message you the moment it's back."
              : "You're on the list - we'll email you the moment it's back.";
            msg.style.display = "block";
            msg.style.color = "var(--gold)";
          }
          var ei = document.getElementById("nf-email"); if (ei) ei.value = "";
          var pi = document.getElementById("nf-phone"); if (pi) pi.value = "";
        } catch (err) {
          if (msg) { msg.textContent = err instanceof Error ? err.message : "Could not save your request."; msg.style.display = "block"; msg.style.color = "var(--text-clay, #a33)"; }
        } finally {
          if (btn) { btn.disabled = false; btn.textContent = "Notify me"; }
        }
      });
    })();
  </script>
</BaseLayout>
