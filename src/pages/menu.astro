---
import BaseLayout from '../layouts/BaseLayout.astro';
import { fetchProducts, getCategories, slugify } from '../lib/fetchProducts.js';
import { fetchSiteContent } from '../lib/fetchSiteContent.js';

const products = await fetchProducts();
const categories = getCategories(products);
const content = await fetchSiteContent();

const categoryTiles = categories.map((cat) => {
  const inCategory = products.filter((p) => p.category === cat);
  const withImage = inCategory.find((p) => p.image_url);
  return {
    name: cat,
    slug: slugify(cat),
    count: inCategory.length,
    image: withImage?.image_url || '',
  };
});
---
<BaseLayout title="Menu — Gobble by Pixie">
  <section class="menu-hero">
    <div class="container">
      <p class="eyebrow">Artisanal Catalog</p>
      <h1>Our Full Menu</h1>
      <p class="section-sub">Small-batch, gluten-free, keto-friendly — crafted fresh, delivered across Delhi NCR. Pick a category to browse.</p>
    </div>
  </section>

  <section class="category-hub">
    <div class="container">
      <div class="category-grid">
        {categoryTiles.map((cat) => (
          <a href={`/menu/${cat.slug}`} class="category-tile card">
            <div class="category-tile-image-wrap">
              {cat.image ? (
                <div class="category-tile-image" style={`background-image: url(${cat.image})`}></div>
              ) : (
                <div class="category-tile-image-placeholder"><span>🧀</span></div>
              )}
            </div>
            <div class="category-tile-body">
              <h3>{cat.name}</h3>
              <p>{cat.count} item{cat.count !== 1 ? 's' : ''}</p>
            </div>
          </a>
        ))}
        <a href="/menu/grazing-tables" class="category-tile card category-tile-grazing">
          <div class="category-tile-image-wrap">
            <div class="category-tile-image-placeholder"><span>🎉</span></div>
          </div>
          <div class="category-tile-body">
            <h3>Grazing Tables</h3>
            <p>{content.grazing_table_price}</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <style>
    .menu-hero { text-align: center; padding-bottom: var(--space-md); }
    .section-sub { max-width: 52ch; margin: 0 auto; color: var(--text-espresso-soft); font-size: 1.05rem; }

    .category-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: var(--space-lg);
    }
    .category-tile {
      display: block; overflow: hidden; transition: transform 0.25s ease, border-color 0.25s ease;
    }
    .category-tile:hover { transform: translateY(-4px); border-color: var(--border-strong); }
    .category-tile-image-wrap { height: 180px; background: var(--bg-parchment-alt); border-bottom: 1px solid var(--border-hairline); }
    .category-tile-image { width: 100%; height: 100%; background-size: contain; background-repeat: no-repeat; background-position: center; }
    .category-tile-image-placeholder {
      width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;
      font-size: 2.4rem; opacity: 0.4;
      background: linear-gradient(150deg, var(--accent-gold-light), var(--bg-parchment-alt));
    }
    .category-tile-body { padding: var(--space-md); }
    .category-tile-body h3 { font-family: var(--font-display); font-size: 1.25rem; margin: 0 0 0.25rem; color: var(--text-espresso); }
    .category-tile-body p { margin: 0; font-size: 0.88rem; color: var(--text-espresso-soft); }
    .category-tile-grazing .category-tile-image-placeholder { background: linear-gradient(150deg, rgba(232,157,23,0.18), var(--bg-parchment-alt)); }
  </style>
</BaseLayout>
