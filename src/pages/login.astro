---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Sign In — Gobble by Pixie" description="Sign in to your account.">

  <section class="auth-section">
    <div class="container auth-wrap">
      <div class="card auth-card">
        <p class="eyebrow">Welcome Back</p>
        <h1>Sign In</h1>
        <p class="auth-sub">Access your orders and Gobble Reward points.</p>

        <form id="login-form" class="auth-form" onsubmit="return false">
          <div class="form-group">
            <label class="field-label" for="li-email">Email Address</label>
            <input id="li-email" type="email" required class="text-field" placeholder="you@example.com" autocomplete="email" />
          </div>

          <div class="form-group">
            <label class="field-label" for="li-pass">Password</label>
            <input id="li-pass" type="password" required class="text-field" placeholder="Enter your password" autocomplete="current-password" />
          </div>

          <p id="li-error" class="auth-error" style="display:none;"></p>

          <button type="button" id="li-btn" class="btn btn-primary auth-submit">Sign In to Account</button>

          <p class="auth-footnote">Don't have an account yet? <a href="/signup">Sign up for free</a></p>
        </form>

        <p id="li-success" class="auth-success" style="display:none;">✓ Signed in successfully. Taking you to your account…</p>
      </div>
    </div>
  </section>

  <style>
    .auth-section { padding: var(--space-2xl) 0; }
    .auth-wrap { max-width: 460px; margin: 0 auto; }
    .auth-card { padding: var(--space-xl); text-align: center; }
    .auth-sub { color: var(--text-muted); font-size: 0.95rem; margin-bottom: var(--space-md); }
    .auth-form { text-align: left; margin-top: var(--space-md); display: flex; flex-direction: column; gap: var(--space-sm); }
    .form-group { text-align: left; }
    .auth-error { color: var(--accent-berry-deep); font-size: 0.88rem; font-weight: 600; text-align: center; }
    .auth-submit { margin-top: var(--space-sm); width: 100%; }
    .auth-footnote { text-align: center; font-size: 0.9rem; color: var(--text-muted); margin-top: var(--space-md); }
    .auth-footnote a { color: var(--accent-teal-deep); font-weight: 700; }
    .auth-success { text-align: center; font-family: var(--font-display); font-size: 1.25rem; color: var(--tag-sage-deep); margin-top: var(--space-md); }
  </style>

  <script is:inline>
    // Console-native auth (2026-10-07): POSTs to our own /api/auth/login proxy,
    // which forwards to Console and sets the session as an httpOnly cookie.
    // The old path hashed the password client-side and sent it to a Google
    // Apps Script web app that kept customers in a Sheet — that backend is
    // retired, so there is nothing to hash for anymore and nothing in
    // localStorage to write. Matches the TCS login page shape.
    async function doLogin() {
      var email = document.getElementById('li-email')?.value.trim();
      var pass = document.getElementById('li-pass')?.value;
      var errEl = document.getElementById('li-error');
      var btn = document.getElementById('li-btn');

      function showErr(msg) { if (errEl) { errEl.textContent = msg; errEl.style.display = 'block'; } }

      if (!email || !pass) return showErr('Please enter your email and password.');
      if (errEl) errEl.style.display = 'none';

      if (btn) { btn.disabled = true; btn.textContent = 'Signing in…'; }

      try {
        var res = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: email, password: pass }),
        });
        var data = await res.json();

        if (!res.ok || !data.success) {
          showErr(data.error || 'Sign in failed. Please try again.');
          if (btn) { btn.disabled = false; btn.textContent = 'Sign In'; }
          return;
        }

        document.getElementById('login-form')?.style.setProperty('display', 'none');
        document.getElementById('li-success').style.display = 'block';
        setTimeout(function () { window.location.href = '/account'; }, 1000);
      } catch (err) {
        showErr('Network error. Please check your connection.');
        if (btn) { btn.disabled = false; btn.textContent = 'Sign In'; }
      }
    }

    document.getElementById('li-btn')?.addEventListener('click', doLogin);
  </script>
</BaseLayout>

