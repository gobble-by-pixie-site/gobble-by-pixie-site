---
import BaseLayout from "../../layouts/BaseLayout.astro";

export const prerender = false;

// Track-your-order page — ported from nanoliss.com (2026-11-11). The
// landing target for the WhatsApp order_shipped_v2 "Track order" button
// (?number= prefill). The lookup needs the order number PLUS the checkout
// email/phone; the number alone never returns anything. Deliberately
// noindex: utility page, not content.

const prefill = Astro.url.searchParams.get("number") ?? "";
---

<BaseLayout title="Track your order — Gobble by Pixie">
  <slot name="head">
    <meta name="robots" content="noindex" />
  </slot>

  <main style="max-width:560px;margin:0 auto;padding:3rem 1.25rem 5rem;min-height:70vh">
    <div style="text-align:center;margin-bottom:2.5rem">
      <p style="text-transform:uppercase;letter-spacing:0.14em;font-size:0.72rem;color:#8a7f6e;margin-bottom:0.75rem">Order tracking</p>
      <h1 style="font-size:clamp(1.8rem,5vw,2.6rem);margin:0 0 0.75rem">Track your order.</h1>
      <p style="color:#6b6154;font-size:0.92rem;line-height:1.6">
        Enter your order number and the email or phone you used at checkout.
      </p>
    </div>

    <form id="track-form" style="display:flex;flex-direction:column;gap:1rem;max-width:420px;margin:0 auto 2.5rem">
      <label style="display:flex;flex-direction:column;gap:0.4rem;text-align:left">
        <span style="font-size:0.72rem;text-transform:uppercase;letter-spacing:0.12em;color:#8a7f6e">Order number</span>
        <input name="number" value={prefill} required placeholder="e.g. GBP/2026/0013"
          style="border:1px solid #d8d0c2;border-radius:8px;padding:0.75rem 0.9rem;font-size:0.92rem;background:#fff" />
      </label>
      <label style="display:flex;flex-direction:column;gap:0.4rem;text-align:left">
        <span style="font-size:0.72rem;text-transform:uppercase;letter-spacing:0.12em;color:#8a7f6e">Email or phone used at checkout</span>
        <input name="contact" required placeholder="you@example.com or 98…"
          style="border:1px solid #d8d0c2;border-radius:8px;padding:0.75rem 0.9rem;font-size:0.92rem;background:#fff" />
      </label>
      <button type="submit" class="btn btn-primary" style="width:fit-content;margin:0 auto">Track order</button>
    </form>

    <div id="track-error" class="hidden" role="alert"
      style="display:none;max-width:420px;margin:0 auto 1.5rem;text-align:center;color:#8a3b2e;font-size:0.9rem"></div>

    <div id="track-result" class="hidden" aria-live="polite"
      style="display:none;max-width:420px;margin:0 auto;border:1px solid #e2dacd;border-radius:12px;padding:1.5rem;background:#fff">
      <p style="text-transform:uppercase;letter-spacing:0.12em;font-size:0.7rem;color:#8a7f6e;margin-bottom:0.5rem">
        Order <span id="t-number" style="font-weight:600"></span>
      </p>
      <p id="t-status" style="font-size:1.6rem;margin:0 0 0.25rem;font-weight:600"></p>
      <p id="t-payment" style="color:#6b6154;font-size:0.8rem;margin-bottom:1.5rem"></p>

      <ol id="t-steps" style="list-style:none;display:flex;justify-content:space-between;gap:0.5rem;padding:0;margin:0 0 1.5rem">
        <li data-step="confirmed" style="flex:1;text-align:center">
          <span class="step-dot" style="display:block;width:10px;height:10px;border-radius:50%;border:1.5px solid #c9c0b0;margin:0 auto 0.5rem"></span>
          <span class="step-label" style="font-size:0.62rem;text-transform:uppercase;letter-spacing:0.12em;color:#a39a8a">Confirmed</span>
        </li>
        <li data-step="shipped" style="flex:1;text-align:center">
          <span class="step-dot" style="display:block;width:10px;height:10px;border-radius:50%;border:1.5px solid #c9c0b0;margin:0 auto 0.5rem"></span>
          <span class="step-label" style="font-size:0.62rem;text-transform:uppercase;letter-spacing:0.12em;color:#a39a8a">Shipped</span>
        </li>
        <li data-step="delivered" style="flex:1;text-align:center">
          <span class="step-dot" style="display:block;width:10px;height:10px;border-radius:50%;border:1.5px solid #c9c0b0;margin:0 auto 0.5rem"></span>
          <span class="step-label" style="font-size:0.62rem;text-transform:uppercase;letter-spacing:0.12em;color:#a39a8a">Delivered</span>
        </li>
      </ol>

      <div id="t-courier-row" class="hidden" style="display:none;border-top:1px solid #eee7dc;padding-top:1.25rem;text-align:left">
        <p style="font-size:0.7rem;text-transform:uppercase;letter-spacing:0.12em;color:#8a7f6e;margin-bottom:0.25rem">Courier</p>
        <p id="t-courier" style="font-size:0.9rem;margin:0"></p>
        <p style="font-size:0.7rem;text-transform:uppercase;letter-spacing:0.12em;color:#8a7f6e;margin:1rem 0 0.25rem">Tracking number</p>
        <p id="t-tracking" style="font-size:0.9rem;margin:0;font-family:monospace;word-break:break-all"></p>
      </div>
      <p id="t-placed" style="color:#a39a8a;font-size:0.75rem;margin-top:1.5rem;text-align:left"></p>
    </div>
  </main>
</BaseLayout>

<script>
  const form = document.getElementById("track-form") as HTMLFormElement;
  const errorBox = document.getElementById("track-error")!;
  const resultBox = document.getElementById("track-result")!;

  const STEP_ORDER: Record<string, number> = { pending: 0, confirmed: 1, shipped: 2, delivered: 3, cancelled: -1 };

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const number = (form.elements.namedItem("number") as HTMLInputElement).value.trim();
    const contact = (form.elements.namedItem("contact") as HTMLInputElement).value.trim();
    errorBox.style.display = "none";
    resultBox.style.display = "none";

    try {
      const res = await fetch(`/api/order-track?number=${encodeURIComponent(number)}&contact=${encodeURIComponent(contact)}`);
      const data = await res.json();
      if (!res.ok) {
        errorBox.textContent = data.error ?? "Something went wrong. Please try again.";
        errorBox.style.display = "block";
        return;
      }
      render(data);
    } catch {
      errorBox.textContent = "Tracking is briefly unavailable. Please try again in a moment.";
      errorBox.style.display = "block";
    }
  });

  function render(o: {
    orderNumber: string;
    status: string;
    paymentStatus: string;
    courier: string | null;
    trackingNumber: string | null;
    placedAt: string;
  }) {
    (document.getElementById("t-number") as HTMLElement).textContent = o.orderNumber;
    (document.getElementById("t-status") as HTMLElement).textContent =
      o.status === "cancelled" ? "Cancelled" : o.status.charAt(0).toUpperCase() + o.status.slice(1);
    (document.getElementById("t-payment") as HTMLElement).textContent = `Payment: ${o.paymentStatus}`;
    (document.getElementById("t-placed") as HTMLElement).textContent = o.placedAt
      ? `Placed ${new Date(o.placedAt).toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric" })}`
      : "";

    const current = STEP_ORDER[o.status] ?? 0;
    document.querySelectorAll<HTMLElement>("#t-steps .step-dot").forEach((dot) => {
      const step = STEP_ORDER[dot.closest("li")?.dataset.step ?? ""] ?? 0;
      const label = dot.nextElementSibling as HTMLElement | null;
      if (step <= current) {
        dot.style.background = "#7a9a5e";
        dot.style.borderColor = "#7a9a5e";
        if (label) label.style.color = "#4c463c";
      } else {
        dot.style.background = "transparent";
        dot.style.borderColor = "#c9c0b0";
        if (label) label.style.color = "#a39a8a";
      }
    });

    const courierRow = document.getElementById("t-courier-row")!;
    if (o.courier || o.trackingNumber) {
      (document.getElementById("t-courier") as HTMLElement).textContent = o.courier ?? "—";
      (document.getElementById("t-tracking") as HTMLElement).textContent = o.trackingNumber ?? "—";
      courierRow.style.display = "block";
    } else {
      courierRow.style.display = "none";
    }
    resultBox.style.display = "block";
  }
</script>
