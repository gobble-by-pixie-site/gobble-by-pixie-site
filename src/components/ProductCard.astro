---
import { formatPrice } from '../lib/fetchProducts.js';
import GlutenFreeIcon from './GlutenFreeIcon.astro';
const { product } = Astro.props;
const dispatchLabel = product.fulfillment === 'weekly-batch' ? 'Batch: Ships Sat' : 'Next-Day Dispatch';
---
<article 
  class="card product-card js-product-card"
  data-id={product.id}
  data-name={product.name}
  data-category={product.category}
  data-subcategory={product.subcategory || ''}
  data-price={product.price || ''}
  data-weight={product.net_weight || ''}
  data-desc={product.description || ''}
  data-image={product.image_url || ''}
  data-fulfillment={dispatchLabel}
  data-dietary={(product.dietary || []).join(',')}
  data-instock={product.in_stock ? 'true' : 'false'}
>
  <div class="image-wrapper">
    {product.image_url ? (
      <div class="product-image" style={`background-image: url(${product.image_url})`}></div>
    ) : (
      <div class="product-image-placeholder">
        <span>🧀</span>
        <p>Photo coming soon</p>
      </div>
    )}
  </div>
  <div class="product-body">
    <div class="badge-row">
      {product.dietary.map((d) => (
        <span class={`badge badge-${d.toLowerCase()}`}>
          {d === 'GF' ? <><GlutenFreeIcon /> Gluten-Free</> : d}
        </span>
      ))}
      <span class="badge badge-dispatch">{dispatchLabel}</span>
    </div>
    <h3 class="product-title" data-lp="name" data-lp-slug={product.id}>{product.name}</h3>
    {product.rating && (
      <div class="rating-row" aria-label={`Rated ${product.rating} out of 5`}>
        <span class="stars" style={`--fill: ${Math.round((product.rating / 5) * 100)}%`} aria-hidden="true">★★★★★</span>
        <span class="rating-num">{product.rating.toFixed(1)}</span>
        {product.review_count > 0 && <span class="review-count">({product.review_count})</span>}
      </div>
    )}
    {product.net_weight && <p class="product-weight">{product.net_weight}</p>}
    {product.description && <p class="product-desc" data-lp="description" data-lp-slug={product.id}>{product.description}</p>}
    <div class="product-footer">
      <span class="product-price" data-lp="price" data-lp-fmt="inr" data-lp-slug={product.id} data-raw-price={product.price || ''}>{formatPrice(product.price)}</span>
      <button type="button" class="btn btn-primary btn-sm js-quick-view-btn" disabled={!product.in_stock}>
        {product.in_stock ? 'Quick View / Order' : 'Sold Out'}
      </button>
    </div>
  </div>
</article>

<script>
  // Cards on pages with the Quick View modal (the per-category menu pages)
  // let that page's own script own the click. Cards on pages without one
  // (e.g. homepage best-sellers) add straight to cart instead, so the
  // button always does something rather than silently no-op.
  const WA_LINK = 'https://wa.link/sngzs9';

  document.addEventListener('click', (e) => {
    const btn = e.target.closest('.js-quick-view-btn');
    if (!btn) return;
    if (document.getElementById('productModalBackdrop')) return; // category page handles this itself

    const card = btn.closest('.js-product-card');
    if (!card) return;

    if (!card.dataset.price) {
      // Price-on-request items never enter the cart — send a direct
      // WhatsApp enquiry instead, same as the Quick View modal does.
      const text = `Hi! I'd like to enquire about ${card.dataset.name} — could you share pricing and availability?`;
      window.open(WA_LINK + '?text=' + encodeURIComponent(text), '_blank', 'noopener');
      return;
    }

    if (!window.GobbleCart) return;
    window.GobbleCart.add({ id: card.dataset.id, name: card.dataset.name, price: Number(card.dataset.price), qty: 1, image: card.dataset.image || '' });
    const original = btn.textContent;
    btn.textContent = 'Added to Cart ✓';
    setTimeout(() => { btn.textContent = original; }, 1200);
  });
</script>

<!-- Console live-draft preview: patches card fields when this page is
     iframed by the product editor (?livedraft=1). Inert otherwise.
     is:inline because it must run per-instance alongside the card markup. -->
<script is:inline>
  (function () {
    if (window.__gbpLiveDraftHooked) return;
    window.__gbpLiveDraftHooked = true;
    var params = new URLSearchParams(location.search);
    if (params.get('livedraft') !== '1') return;
    window.addEventListener('message', function (e) {
      var d = e.data || {};
      if (d.type !== 'lc-product-preview' || !d.patch || !d.slug) return;
      document.querySelectorAll('[data-lp]').forEach(function (el) {
        if ((el.getAttribute('data-lp-slug') || '') !== d.slug) return;
        var k = el.getAttribute('data-lp');
        var v = d.patch[k];
        if (v === undefined || v === null) {
          if (k === 'price' && !el.getAttribute('data-raw-price')) el.textContent = 'Price on request';
          return;
        }
        if (k === 'image') {
          if (el.tagName === 'IMG') el.src = v; else el.style.backgroundImage = "url('" + v + "')";
          return;
        }
        el.textContent = el.getAttribute('data-lp-fmt') === 'inr'
          ? new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR', maximumFractionDigits: 0 }).format(Number(v))
          : String(v);
        if (k === 'price') el.setAttribute('data-raw-price', String(v));
      });
    });
    parent.postMessage({ type: 'lc-preview-ready' }, '*');
  })();
</script>

<style>
  .product-card {
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: transform 0.25s ease, border-color 0.25s ease;
  }
  .product-card:hover {
    transform: translateY(-4px);
    border-color: var(--border-strong);
  }
  .image-wrapper {
    position: relative;
    height: 230px;
    overflow: hidden;
    border-bottom: 1px solid var(--border-hairline);
    background: var(--bg-parchment-alt);
  }
  .product-image {
    width: 100%;
    height: 100%;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .product-card:hover .product-image {
    transform: scale(1.06);
  }
  .product-image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    background: linear-gradient(150deg, var(--accent-gold-light), var(--bg-parchment-alt));
    color: var(--text-espresso-soft);
  }
  .product-image-placeholder span {
    font-size: 2.6rem;
    opacity: 0.5;
  }
  .product-image-placeholder p {
    font-size: 0.78rem;
    font-weight: 600;
    margin: 0;
    opacity: 0.55;
  }

  .product-body {
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }
  .badge-row {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-bottom: var(--space-xs);
  }
  .product-title {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
    margin-bottom: 0.2rem;
    line-height: 1.25;
  }
  .rating-row {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-bottom: 0.35rem;
  }
  .stars {
    position: relative;
    display: inline-block;
    font-size: 0.9rem;
    line-height: 1;
    letter-spacing: 1px;
    color: rgba(36, 21, 18, 0.18);
  }
  .stars::before {
    content: '★★★★★';
    position: absolute;
    inset: 0;
    width: var(--fill);
    overflow: hidden;
    color: var(--accent-gold-deep);
    white-space: nowrap;
  }
  .rating-num {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--text-espresso);
  }
  .review-count {
    font-size: 0.78rem;
    color: var(--text-espresso-soft);
    opacity: 0.65;
  }
  .product-weight {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--accent-gold-deep);
    margin-bottom: 0.5rem;
  }
  .product-desc {
    font-size: 0.88rem;
    color: var(--text-espresso-soft);
    margin-bottom: var(--space-md);
    line-height: 1.5;
    flex-grow: 1;
  }
  .product-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-xs);
    border-top: 1px solid rgba(196, 121, 6, 0.1);
    margin-top: auto;
  }
  .product-price {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text-espresso);
  }
  .btn-sm {
    padding: 0.55rem 1.25rem;
    font-size: 0.85rem;
  }
  .btn-sm:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    background: #ccc;
    box-shadow: none;
  }
</style>

